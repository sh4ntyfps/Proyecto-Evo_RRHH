@model RRHH_Salud
@{
    ViewData["Title"] = "Ficha de salud";
    var esNuevo = Model.idSalud == 0;
    var idEmpleado = ViewBag.IdEmpleado as int? ?? Model.IdEmpleado;
    var empleados = ViewBag.Empleados as List<(int Id, string Nombre)> ?? new List<(int, string)>();
    var acude = ViewBag.AcudeEnferm as List<RRHH_AcudeEnferm> ?? new List<RRHH_AcudeEnferm>();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>@(esNuevo ? "Nueva ficha de salud" : "Editar ficha de salud")</h3>
    <a asp-action="Index" asp-route-idEmpleado="@idEmpleado" class="btn btn-outline-secondary">Volver</a>
</div>

<form asp-action="@(esNuevo ? "SaludNuevo" : "SaludEditar")" method="post">
    <div class="card">
        <div class="card-body">
            @if (!esNuevo)
            {
                <input type="hidden" asp-for="idSalud" />
            }
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Empleado</label>
                    <select asp-for="IdEmpleado" class="form-select">
                        <option value="">(seleccionar)</option>
                        @foreach (var e in empleados)
                        {
                            <option value="@e.Id">@e.Nombre</option>
                        }
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Acudir en caso de enfermedad</label>
                    <select asp-for="idAcudeEnferm" class="form-select">
                        <option value="">(sin asignar)</option>
                        @foreach (var a in acude)
                        {
                            <option value="@a.idAcudeEnferm">@a.AcudeEnfermDescrip</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Enfermedad crónica</label>
                    <select asp-for="EnferCronica" class="form-select">
                        <option value="">(sin asignar)</option>
                        <option value="true" selected="@(Model.EnferCronica == true)">Sí</option>
                        <option value="false" selected="@(Model.EnferCronica == false)">No</option>
                    </select>
                </div>
                <div class="col-md-8">
                    <label class="form-label">Descripción de enfermedad</label>
                    <input asp-for="EnferCronicaDescrip" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Discapacidad en familia</label>
                    <select asp-for="FamDiscapacidad" class="form-select">
                        <option value="">(sin asignar)</option>
                        <option value="true" selected="@(Model.FamDiscapacidad == true)">Sí</option>
                        <option value="false" selected="@(Model.FamDiscapacidad == false)">No</option>
                    </select>
                </div>
                <div class="col-md-8">
                    <label class="form-label">Descripción de discapacidad</label>
                    <input asp-for="FamDiscapDescrip" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Alérgico</label>
                    <select asp-for="Alergico" class="form-select">
                        <option value="">(sin asignar)</option>
                        <option value="true" selected="@(Model.Alergico == true)">Sí</option>
                        <option value="false" selected="@(Model.Alergico == false)">No</option>
                    </select>
                </div>
                <div class="col-md-8">
                    <label class="form-label">Descripción de alergia</label>
                    <input asp-for="AlergicoDescrip" class="form-control" />
                </div>
            </div>
        </div>
        <div class="card-footer d-flex justify-content-end">
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Guardar</button>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}