@model RRHH_AcudeEnferm
@{
    ViewData["Title"] = "A quién acudir";
    var esNuevo = Model.idAcudeEnferm == 0;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>@(esNuevo ? "Nueva opción" : "Editar opción")</h3>
    <a asp-action="AcudeEnferm" class="btn btn-outline-secondary">Volver</a>
</div>

<form asp-action="@(esNuevo ? "AcudeEnfermNuevo" : "AcudeEnfermEditar")" method="post">
    <div class="card">
        <div class="card-body">
            @if (!esNuevo)
            {
                <input type="hidden" asp-for="idAcudeEnferm" />
            }
            <div class="row g-3">
                <div class="col-md-8">
                    <label class="form-label">Descripción *</label>
                    <input asp-for="AcudeEnfermDescrip" class="form-control" required placeholder="Ej. Familiares, Vecinos, Centro médico..." />
                </div>
            </div>
        </div>
        <div class="card-footer d-flex justify-content-end">
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Guardar</button>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}