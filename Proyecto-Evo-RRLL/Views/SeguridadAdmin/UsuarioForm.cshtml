@model Usuario
@{
    ViewData["Title"] = "Usuario";
    var esNuevo = Model.IdUsuario == 0;
    var empleados = ViewBag.Empleados as List<(int Id, string Nombre)> ?? new List<(int, string)>();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>@(esNuevo ? "Nuevo usuario" : $"Editar usuario: {Model.Login}")</h3>
    <a asp-action="Usuarios" class="btn btn-outline-secondary">Volver</a>
</div>

<form asp-action="@(esNuevo ? "UsuarioNuevo" : "UsuarioEditar")" method="post">
    <div class="card">
        <div class="card-body">
            @if (!esNuevo)
            {
                <input type="hidden" asp-for="IdUsuario" />
                <input type="hidden" asp-for="PasswordHash" />
            }
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Login *</label>
                    <input asp-for="Login" class="form-control" required placeholder="Ej. rperez" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Descripción</label>
                    <input asp-for="Descripcion" class="form-control" placeholder="Nombre o rol mostrado al iniciar sesión" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Clave @(esNuevo ? "*" : "(dejar vacío para no cambiar)")</label>
                    <input type="password" name="clave" class="form-control" @(esNuevo ? "required" : "") placeholder="••••••••" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Empleado</label>
                    <select asp-for="IdEmpleado" class="form-select">
                        <option value="">(sin asignar)</option>
                        @foreach (var e in empleados)
                        {
                            <option value="@e.Id">@e.Nombre</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Estado</label>
                    <select asp-for="Estado" class="form-select">
                        <option value="true" selected="@(Model.Estado == true)">Activo</option>
                        <option value="false" selected="@(Model.Estado == false)">Inactivo</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="card-footer d-flex justify-content-between">
            @if (!esNuevo)
            {
                <a asp-action="UsuarioRoles" asp-route-id="@Model.IdUsuario" class="btn btn-outline-secondary"><i class="bi bi-shield me-1"></i>Asignar roles</a>
            }
            <div class="ms-auto">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Guardar</button>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}