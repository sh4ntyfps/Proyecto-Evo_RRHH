@model List<Capa_Entidades.Bitacora>
@{
    ViewData["Title"] = "Bitacora de actividad";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Bitacora de actividad</h3>
    <span class="text-muted">Ultimas @Model.Count entradas</span>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">
        Sin registros. Si la tabla Bitacora aun no existe en la base de datos, ejecute el script
        <code>Scripts\crear_bitacora.sql</code>.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Usuario</th>
                    <th>Accion</th>
                    <th>Entidad</th>
                    <th>Detalle</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="text-nowrap">@item.Fecha.ToString("dd/MM/yyyy HH:mm:ss")</td>
                        <td>@item.Usuario</td>
                        <td><span class="badge bg-secondary">@item.Accion</span></td>
                        <td>@item.Entidad</td>
                        <td class="text-break">@item.Detalle</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}