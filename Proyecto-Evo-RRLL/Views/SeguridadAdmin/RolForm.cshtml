@model Rol
@{
    ViewData["Title"] = "Rol";
    var esNuevo = Model.IdRol == 0;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>@(esNuevo ? "Nuevo rol" : $"Editar rol: {Model.Descripcion}")</h3>
    <a asp-action="Roles" class="btn btn-outline-secondary">Volver</a>
</div>

<form asp-action="@(esNuevo ? "RolNuevo" : "RolEditar")" method="post">
    <div class="card">
        <div class="card-body">
            @if (!esNuevo)
            {
                <input type="hidden" asp-for="IdRol" />
            }
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Descripción *</label>
                    <input asp-for="Descripcion" class="form-control" required placeholder="Ej. Administrador" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Sistema</label>
                    <input asp-for="IdSistema" class="form-control" placeholder="Ej. RRHH" />
                </div>
            </div>
        </div>
        <div class="card-footer d-flex justify-content-between">
            @if (!esNuevo)
            {
                <a asp-action="RolAccesos" asp-route-id="@Model.IdRol" class="btn btn-outline-secondary"><i class="bi bi-key me-1"></i>Permisos</a>
            }
            <div class="ms-auto">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Guardar</button>
            </div>
        </div>
    </div>
</form>