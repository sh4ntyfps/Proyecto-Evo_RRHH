@model DashboardViewModel
@{
    ViewData["Title"] = "Inicio";
}

<div class="mb-4">
    <h3 class="mb-1">Bienvenido, @User.Identity?.Name</h3>
    <p class="text-secondary mb-0">Sistema de Gestión de Recursos Humanos</p>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4 col-sm-6">
        <div class="card stat-card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon bg-primary-subtle text-primary"><i class="bi bi-people"></i></div>
                <div>
                    <div class="text-secondary small text-uppercase">Empleados</div>
                    <div class="fs-3 fw-bold">@Model.Empleados</div>
                </div>
            </div>
            <div class="card-footer bg-transparent py-2">
                <a asp-controller="Empleado" asp-action="Index" class="small text-decoration-none">Ir a Personal <i class="bi bi-arrow-right"></i></a>
            </div>
        </div>
    </div>
    <div class="col-md-4 col-sm-6">
        <div class="card stat-card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon bg-success-subtle text-success"><i class="bi bi-person-vcard"></i></div>
                <div>
                    <div class="text-secondary small text-uppercase">Personas</div>
                    <div class="fs-3 fw-bold">@Model.Personas</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4 col-sm-6">
        <div class="card stat-card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon bg-info-subtle text-info"><i class="bi bi-clock-history"></i></div>
                <div>
                    <div class="text-secondary small text-uppercase">Asistencias hoy</div>
                    <div class="fs-3 fw-bold">@Model.asistenciasHoy</div>
                </div>
            </div>
            <div class="card-footer bg-transparent py-2">
                <a asp-controller="Asistencia" asp-action="Index" class="small text-decoration-none">Ir a Asistencia <i class="bi bi-arrow-right"></i></a>
            </div>
        </div>
    </div>
    <div class="col-md-4 col-sm-6">
        <div class="card stat-card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon bg-warning-subtle text-warning"><i class="bi bi-diagram-3"></i></div>
                <div>
                    <div class="text-secondary small text-uppercase">Áreas</div>
                    <div class="fs-3 fw-bold">@Model.Areas</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4 col-sm-6">
        <div class="card stat-card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon bg-danger-subtle text-danger"><i class="bi bi-briefcase"></i></div>
                <div>
                    <div class="text-secondary small text-uppercase">Cargos</div>
                    <div class="fs-3 fw-bold">@Model.Cargos</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4 col-sm-6">
        <div class="card stat-card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon bg-primary-subtle text-primary"><i class="bi bi-grid-1x2"></i></div>
                <div>
                    <div class="text-secondary small text-uppercase">Catálogos</div>
                    <div class="fs-3 fw-bold">@CatalogoNavegacion.Items.Count</div>
                </div>
            </div>
            <div class="card-footer bg-transparent py-2">
                <a asp-controller="Catalogo" asp-action="Index" asp-route-tabla="Cargo" class="small text-decoration-none">Abrir Mantenimiento <i class="bi bi-arrow-right"></i></a>
            </div>
        </div>
    </div>
</div>