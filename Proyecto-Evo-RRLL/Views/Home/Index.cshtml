@model DashboardViewModel
@{
    ViewData["Title"] = "Panel";
    var hora = DateTime.Now.Hour;
    var saludo = hora < 12 ? "Buenos días" : hora < 19 ? "Buenas tardes" : "Buenas noches";
    var cultura = new System.Globalization.CultureInfo("es-PE");
    var fechaHoy = DateTime.Now.ToString("dddd d 'de' MMMM 'de' yyyy", cultura);
    fechaHoy = char.ToUpper(fechaHoy[0]) + fechaHoy[1..];
    var inactivos = Model.Empleados - Model.EmpleadosActivos;
    var porcentajeActivos = Model.Empleados == 0 ? 0 : (int)Math.Round(Model.EmpleadosActivos * 100.0 / Model.Empleados);
    var porcentajeAsistencia = Model.EmpleadosActivos == 0 ? 0 : Math.Min(100, (int)Math.Round(Model.asistenciasHoy * 100.0 / Model.EmpleadosActivos));

    var indicadores = new[]
    {
        new { Valor = Model.EmpleadosActivos.ToString("N0", cultura), Titulo = "Empleados activos", Detalle = $"{porcentajeActivos}% del personal", Icono = "bi-people-fill", Color = "tw-from-marca-500 tw-to-marca-700", Controlador = "Empleado" },
        new { Valor = Model.asistenciasHoy.ToString("N0", cultura), Titulo = "Asistencias hoy", Detalle = $"{porcentajeAsistencia}% de los activos", Icono = "bi-fingerprint", Color = "tw-from-emerald-400 tw-to-teal-600", Controlador = "Asistencia" },
        new { Valor = Model.Areas.ToString("N0", cultura), Titulo = "Unidades orgánicas", Detalle = $"{Model.Cargos:N0} cargos definidos", Icono = "bi-diagram-3-fill", Color = "tw-from-violet-500 tw-to-fuchsia-600", Controlador = "EstructuraOrganiz" },
        new { Valor = Model.FeriadosMes.Count.ToString(), Titulo = "Feriados del mes", Detalle = Model.FeriadosMes.Count == 0 ? "Sin feriados registrados" : "Revisa el calendario", Icono = "bi-calendar-heart-fill", Color = "tw-from-amber-400 tw-to-orange-500", Controlador = "Feriado" },
    };
}

@* ---------- Bienvenida ---------- *@
<section class="tw-relative tw-mb-8 tw-overflow-hidden tw-rounded-3xl tw-bg-gradient-to-br tw-from-marca-600 tw-via-marca-700 tw-to-violet-700 tw-p-6 tw-text-white tw-shadow-elevada md:tw-p-10">
    <div class="tw-fondo-malla tw-absolute tw-inset-0 tw-opacity-60" aria-hidden="true"></div>
    <div class="tw-absolute -tw-right-16 -tw-top-24 tw-h-72 tw-w-72 tw-rounded-full tw-bg-cyan-400/30 tw-blur-3xl" aria-hidden="true"></div>
    <div class="tw-absolute -tw-bottom-24 tw-left-1/3 tw-h-64 tw-w-64 tw-rounded-full tw-bg-fuchsia-500/30 tw-blur-3xl" aria-hidden="true"></div>

    <div class="tw-relative tw-flex tw-flex-col tw-gap-8 lg:tw-flex-row lg:tw-items-center lg:tw-justify-between">
        <div class="tw-max-w-2xl">
            <span class="tw-inline-flex tw-items-center tw-gap-2 tw-rounded-full tw-bg-white/15 tw-px-3 tw-py-1 tw-text-xs tw-font-semibold tw-ring-1 tw-ring-white/25 tw-backdrop-blur">
                <i class="bi bi-calendar3"></i>@fechaHoy
            </span>
            <h2 class="tw-mb-2 tw-mt-4 tw-text-3xl tw-font-extrabold tw-text-white md:tw-text-4xl">@saludo, @User.Identity?.Name 👋</h2>
            <p class="tw-m-0 tw-text-base tw-text-marca-100 md:tw-text-lg">
                Hoy tienes <strong class="tw-text-white">@Model.EmpleadosActivos.ToString("N0", cultura) colaboradores activos</strong>
                y <strong class="tw-text-white">@Model.asistenciasHoy.ToString("N0", cultura) marcaciones</strong> registradas.
            </p>
            <div class="tw-mt-6 tw-flex tw-flex-wrap tw-gap-3">
                <a asp-controller="Empleado" asp-action="Nuevo" class="tw-inline-flex tw-items-center tw-gap-2 tw-rounded-xl tw-bg-white tw-px-5 tw-py-3 tw-text-sm tw-font-bold tw-text-marca-700 tw-no-underline tw-shadow-lg tw-transition hover:-tw-translate-y-0.5 hover:tw-shadow-xl">
                    <i class="bi bi-person-plus-fill"></i>Nuevo empleado
                </a>
                <a asp-controller="Permiso" asp-action="Nuevo" class="tw-inline-flex tw-items-center tw-gap-2 tw-rounded-xl tw-bg-white/10 tw-px-5 tw-py-3 tw-text-sm tw-font-bold tw-text-white tw-no-underline tw-ring-1 tw-ring-white/30 tw-backdrop-blur tw-transition hover:tw-bg-white/20">
                    <i class="bi bi-calendar-plus"></i>Registrar permiso
                </a>
            </div>
        </div>

        @* Tarjeta de cobertura: el porcentaje de asistencia del dia *@
        <div class="tw-w-full tw-max-w-sm tw-rounded-2xl tw-bg-white/10 tw-p-5 tw-ring-1 tw-ring-white/20 tw-backdrop-blur-md lg:tw-w-80">
            <div class="tw-flex tw-items-center tw-justify-between tw-text-sm tw-font-semibold tw-text-marca-100">
                <span>Cobertura de asistencia</span><i class="bi bi-graph-up-arrow"></i>
            </div>
            <div class="tw-mt-2 tw-text-5xl tw-font-extrabold">@porcentajeAsistencia<span class="tw-text-2xl tw-text-marca-200">%</span></div>
            <div class="tw-mt-4 tw-h-2.5 tw-overflow-hidden tw-rounded-full tw-bg-white/15">
                <div class="tw-h-full tw-rounded-full tw-bg-gradient-to-r tw-from-cyan-300 tw-to-emerald-300" style="width:@porcentajeAsistencia%"></div>
            </div>
            <p class="tw-mb-0 tw-mt-3 tw-text-xs tw-text-marca-100">@Model.asistenciasHoy de @Model.EmpleadosActivos empleados activos marcaron hoy</p>
        </div>
    </div>
</section>

@* ---------- Indicadores ---------- *@
<section class="tw-mb-8 tw-grid tw-grid-cols-2 tw-gap-3 sm:tw-gap-5 xl:tw-grid-cols-4" aria-label="Indicadores">
    @foreach (var i in indicadores)
    {
        <a asp-controller="@i.Controlador" asp-action="Index"
           class="tw-group tw-relative tw-overflow-hidden tw-rounded-2xl tw-border tw-border-slate-200/80 tw-bg-white tw-p-4 sm:tw-p-5 tw-text-inherit tw-no-underline tw-shadow-suave tw-transition hover:-tw-translate-y-1 hover:tw-border-marca-200 hover:tw-shadow-xl dark:tw-border-slate-800 dark:tw-bg-slate-900">
            <div class="tw-flex tw-items-start tw-justify-between">
                <span class="tw-grid tw-h-12 tw-w-12 tw-place-items-center tw-rounded-xl tw-bg-gradient-to-br @i.Color tw-text-xl tw-text-white tw-shadow-lg">
                    <i class="bi @i.Icono"></i>
                </span>
                <span class="tw-grid tw-h-8 tw-w-8 tw-place-items-center tw-rounded-full tw-text-slate-300 tw-transition group-hover:tw-bg-marca-50 group-hover:tw-text-marca-600 dark:group-hover:tw-bg-slate-800">
                    <i class="bi bi-arrow-up-right"></i>
                </span>
            </div>
            <div class="tw-mt-4 tw-text-2xl tw-font-extrabold sm:tw-mt-5 sm:tw-text-3xl tw-tracking-tight tw-text-slate-900 dark:tw-text-white">@i.Valor</div>
            <div class="tw-mt-1 tw-text-sm tw-font-semibold tw-text-slate-600 dark:tw-text-slate-300">@i.Titulo</div>
            <div class="tw-mt-3 tw-text-xs tw-font-medium tw-text-slate-400">@i.Detalle</div>
        </a>
    }
</section>

@* ---------- Graficos ---------- *@
<div class="tw-grid tw-gap-5 xl:tw-grid-cols-3">
    <section class="card xl:tw-col-span-2">
        <div class="tw-flex tw-items-center tw-justify-between tw-px-6 tw-pt-6">
            <div>
                <h2 class="tw-m-0 tw-text-lg">Asistencia semanal</h2>
                <p class="tw-m-0 tw-text-sm tw-text-slate-500">Marcaciones de los últimos 7 días</p>
            </div>
            <a asp-controller="Asistencia" asp-action="Index" class="btn btn-sm btn-outline-secondary">Ver detalle</a>
        </div>
        <div class="tw-p-4 md:tw-p-6"><div class="chart-box"><canvas id="chartAsistencia" role="img" aria-label="Asistencias de los últimos 7 días"></canvas></div></div>
    </section>

    <section class="card">
        <div class="tw-px-6 tw-pt-6">
            <h2 class="tw-m-0 tw-text-lg">Estado del personal</h2>
            <p class="tw-m-0 tw-text-sm tw-text-slate-500">@Model.Empleados.ToString("N0", cultura) registrados · @inactivos inactivos</p>
        </div>
        <div class="tw-relative tw-p-6">
            <div class="chart-box"><canvas id="chartEstados" role="img" aria-label="Empleados por estado"></canvas></div>
            <div class="tw-pointer-events-none tw-absolute tw-inset-x-0 tw-top-[42%] tw-text-center">
                <div class="tw-text-3xl tw-font-extrabold">@porcentajeActivos%</div>
                <div class="tw-text-xs tw-font-semibold tw-text-slate-500">activos</div>
            </div>
        </div>
    </section>

    <section class="card xl:tw-col-span-2">
        <div class="tw-flex tw-items-center tw-justify-between tw-px-6 tw-pt-6">
            <div>
                <h2 class="tw-m-0 tw-text-lg">Personal por área</h2>
                <p class="tw-m-0 tw-text-sm tw-text-slate-500">Distribución en las unidades orgánicas</p>
            </div>
            <a asp-controller="EstructuraOrganiz" asp-action="Index" class="btn btn-sm btn-outline-secondary">Ver estructura</a>
        </div>
        <div class="tw-p-4 md:tw-p-6"><div class="chart-box"><canvas id="chartAreas" role="img" aria-label="Empleados por área"></canvas></div></div>
    </section>

    <section class="card">
        <div class="tw-flex tw-items-center tw-justify-between tw-px-6 tw-pt-6">
            <h2 class="tw-m-0 tw-text-lg">Feriados del mes</h2>
            <a asp-controller="Feriado" asp-action="Index" class="tw-text-sm tw-font-semibold tw-no-underline">Ver todos</a>
        </div>
        <div class="tw-p-6">
            @if (Model.FeriadosMes.Count == 0)
            {
                <div class="tw-rounded-2xl tw-border-2 tw-border-dashed tw-border-slate-200 tw-p-8 tw-text-center dark:tw-border-slate-700">
                    <i class="bi bi-calendar2-x tw-text-3xl tw-text-slate-300"></i>
                    <p class="tw-mb-3 tw-mt-2 tw-text-sm tw-text-slate-500">No hay feriados registrados este mes.</p>
                    <a asp-controller="Feriado" asp-action="Nuevo" class="btn btn-sm btn-outline-primary">Registrar feriado</a>
                </div>
            }
            else
            {
                <ul class="tw-m-0 tw-list-none tw-space-y-3 tw-p-0">
                    @foreach (var f in Model.FeriadosMes)
                    {
                        var partes = f.Split(" - ", 2);
                        var diaMes = partes[0].Split('/');
                        var mes = diaMes.Length == 2 && int.TryParse(diaMes[1], out var m) ? cultura.DateTimeFormat.GetAbbreviatedMonthName(m).TrimEnd('.').ToUpper() : "";
                        <li class="tw-flex tw-items-center tw-gap-4 tw-rounded-2xl tw-border tw-border-slate-100 tw-p-3 tw-transition hover:tw-border-amber-200 hover:tw-bg-amber-50/50 dark:tw-border-slate-800 dark:hover:tw-bg-amber-500/5">
                            <div class="tw-w-14 tw-shrink-0 tw-overflow-hidden tw-rounded-xl tw-text-center tw-shadow-sm tw-ring-1 tw-ring-slate-200 dark:tw-ring-slate-700">
                                <div class="tw-bg-gradient-to-r tw-from-amber-400 tw-to-orange-500 tw-py-0.5 tw-text-[.65rem] tw-font-bold tw-text-white">@mes</div>
                                <div class="tw-bg-white tw-py-1 tw-text-xl tw-font-extrabold dark:tw-bg-slate-900">@diaMes[0]</div>
                            </div>
                            <div class="tw-min-w-0">
                                <div class="tw-truncate tw-font-semibold">@(partes.Length > 1 ? partes[1] : "Feriado")</div>
                                <div class="tw-text-xs tw-text-slate-500">Día no laborable</div>
                            </div>
                        </li>
                    }
                </ul>
            }
        </div>
    </section>
</div>

@section Scripts {
    <script src="~/lib/chart.js/chart.umd.min.js"></script>
    <script>
        (function () {
            var areasNombres = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.AreasNombres));
            var areasData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.EmpleadosPorArea));
            var diasAsis = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DiasAsistencia));
            var asisData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.AsistenciasPorDia));
            var estadosNombres = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.EstadosNombres));
            var estadosData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.EmpleadosPorEstado));

            function oscuro() { return document.documentElement.getAttribute('data-bs-theme') === 'dark'; }
            function colores() {
                return oscuro()
                    ? { texto: '#cbd5e1', suave: '#64748b', grilla: 'rgba(148,163,184,.12)', fondo: '#0f172a' }
                    : { texto: '#334155', suave: '#94a3b8', grilla: 'rgba(148,163,184,.18)', fondo: '#ffffff' };
            }

            Chart.defaults.font.family = '"Plus Jakarta Sans", Inter, system-ui, sans-serif';
            Chart.defaults.font.size = 12.5;

            function degradado(ctx, area, desde, hasta) {
                var g = ctx.createLinearGradient(0, area.top, 0, area.bottom);
                g.addColorStop(0, desde); g.addColorStop(1, hasta); return g;
            }
            function tooltip() {
                return { backgroundColor: '#0f172a', padding: 12, cornerRadius: 12, titleFont: { weight: '700' }, displayColors: false };
            }
            function etiquetaCorta(valor) {
                var texto = this.getLabelForValue(valor);
                var max = window.innerWidth < 576 ? 16 : 30;
                return texto.length > max ? texto.slice(0, max - 1) + '…' : texto;
            }
            function ejes(c, horizontal) {
                var valor = { beginAtZero: true, ticks: { precision: 0, color: c.suave }, grid: { color: c.grilla }, border: { display: false } };
                var categoria = { ticks: { color: c.texto, autoSkip: false, callback: etiquetaCorta }, grid: { display: false }, border: { display: false } };
                return horizontal ? { x: valor, y: categoria } : { x: categoria, y: valor };
            }

            var c = colores();

            var chartAsistencia = new Chart(document.getElementById('chartAsistencia'), {
                type: 'line',
                data: {
                    labels: diasAsis,
                    datasets: [{
                        label: 'Asistencias', data: asisData, cubicInterpolationMode: 'monotone', fill: true, borderWidth: 3,
                        borderColor: '#3461ff', pointBackgroundColor: '#fff', pointBorderColor: '#3461ff', pointBorderWidth: 2.5, pointRadius: 4.5, pointHoverRadius: 7,
                        backgroundColor: function (ctx) {
                            var a = ctx.chart.chartArea; if (!a) return 'transparent';
                            return degradado(ctx.chart.ctx, a, 'rgba(52,97,255,.35)', 'rgba(52,97,255,0)');
                        }
                    }]
                },
                options: { responsive: true, maintainAspectRatio: false, interaction: { intersect: false, mode: 'index' },
                    plugins: { legend: { display: false }, tooltip: tooltip() }, scales: ejes(c, false) }
            });

            var chartEstados = new Chart(document.getElementById('chartEstados'), {
                type: 'doughnut',
                data: { labels: estadosNombres, datasets: [{ data: estadosData, backgroundColor: ['#3461ff', '#a78bfa', '#22d3ee', '#f59e0b', '#f43f5e'], borderColor: c.fondo, borderWidth: 4, hoverOffset: 6, borderRadius: 6 }] },
                options: { responsive: true, maintainAspectRatio: false, cutout: '74%',
                    plugins: { legend: { position: 'bottom', labels: { color: c.texto, usePointStyle: true, pointStyle: 'circle', padding: 16 } }, tooltip: tooltip() } }
            });

            var chartAreas = new Chart(document.getElementById('chartAreas'), {
                type: 'bar',
                data: { labels: areasNombres, datasets: [{ label: 'Empleados', data: areasData, borderRadius: 8, borderSkipped: false, maxBarThickness: 26,
                    backgroundColor: function (ctx) {
                        var a = ctx.chart.chartArea; if (!a) return '#3461ff';
                        var g = ctx.chart.ctx.createLinearGradient(a.left, 0, a.right, 0);
                        g.addColorStop(0, '#5b83ff'); g.addColorStop(1, '#8b5cf6'); return g;
                    } }] },
                options: { indexAxis: 'y', responsive: true, maintainAspectRatio: false,
                    plugins: { legend: { display: false }, tooltip: tooltip() }, scales: ejes(c, true) }
            });

            // Al cambiar de tema se recolorean ejes y leyendas sin recargar
            document.addEventListener('evo:theme', function () {
                var c = colores();
                chartAsistencia.options.scales = ejes(c, false);
                chartAreas.options.scales = ejes(c, true);
                chartEstados.data.datasets[0].borderColor = c.fondo;
                chartEstados.options.plugins.legend.labels.color = c.texto;
                [chartAsistencia, chartAreas, chartEstados].forEach(function (g) { g.update(); });
            });
        })();
    </script>
}
