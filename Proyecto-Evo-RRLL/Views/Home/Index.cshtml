@model DashboardViewModel
@{
    ViewData["Title"] = "Inicio";
}

<div class="mb-4">
    <h3 class="mb-1">Bienvenido, @User.Identity?.Name</h3>
    <p class="text-secondary mb-0">Sistema de Gestión de Recursos Humanos</p>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4 col-sm-6">
        <div class="card stat-card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon bg-primary-subtle text-primary"><i class="bi bi-people"></i></div>
                <div>
                    <div class="text-secondary small text-uppercase">Empleados</div>
                    <div class="fs-3 fw-bold">@Model.Empleados</div>
                </div>
            </div>
            <div class="card-footer bg-transparent py-2">
                <a asp-controller="Empleado" asp-action="Index" class="small text-decoration-none">Ir a Personal <i class="bi bi-arrow-right"></i></a>
            </div>
        </div>
    </div>
    <div class="col-md-4 col-sm-6">
        <div class="card stat-card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon bg-success-subtle text-success"><i class="bi bi-person-vcard"></i></div>
                <div>
                    <div class="text-secondary small text-uppercase">Personas</div>
                    <div class="fs-3 fw-bold">@Model.Personas</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4 col-sm-6">
        <div class="card stat-card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon bg-info-subtle text-info"><i class="bi bi-clock-history"></i></div>
                <div>
                    <div class="text-secondary small text-uppercase">Asistencias hoy</div>
                    <div class="fs-3 fw-bold">@Model.asistenciasHoy</div>
                </div>
            </div>
            <div class="card-footer bg-transparent py-2">
                <a asp-controller="Asistencia" asp-action="Index" class="small text-decoration-none">Ir a Asistencia <i class="bi bi-arrow-right"></i></a>
            </div>
        </div>
    </div>
    <div class="col-md-4 col-sm-6">
        <div class="card stat-card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon bg-warning-subtle text-warning"><i class="bi bi-diagram-3"></i></div>
                <div>
                    <div class="text-secondary small text-uppercase">Áreas</div>
                    <div class="fs-3 fw-bold">@Model.Areas</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4 col-sm-6">
        <div class="card stat-card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon bg-danger-subtle text-danger"><i class="bi bi-briefcase"></i></div>
                <div>
                    <div class="text-secondary small text-uppercase">Cargos</div>
                    <div class="fs-3 fw-bold">@Model.Cargos</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4 col-sm-6">
        <div class="card stat-card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon bg-primary-subtle text-primary"><i class="bi bi-grid-1x2"></i></div>
                <div>
                    <div class="text-secondary small text-uppercase">Catálogos</div>
                    <div class="fs-3 fw-bold">@CatalogoNavegacion.Items.Count</div>
                </div>
            </div>
            <div class="card-footer bg-transparent py-2">
                <a asp-controller="Catalogo" asp-action="Index" asp-route-tabla="Cargo" class="small text-decoration-none">Abrir Mantenimiento <i class="bi bi-arrow-right"></i></a>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-2">
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-body">
                <h6 class="fw-semibold mb-3"><i class="bi bi-diagram-3 me-2 text-primary"></i>Empleados por área</h6>
                <canvas id="chartAreas"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-body">
                <h6 class="fw-semibold mb-3"><i class="bi bi-clock-history me-2 text-success"></i>Asistencias últimos 7 días</h6>
                <canvas id="chartAsistencia"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-body">
                <h6 class="fw-semibold mb-3"><i class="bi bi-person-badge me-2 text-warning"></i>Empleados por estado</h6>
                <canvas id="chartEstados"></canvas>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/chart.js/chart.umd.min.js"></script>
    <script>
        (function () {
            var oscuro = document.documentElement.getAttribute('data-bs-theme') === 'dark';
            var etiquetaColor = oscuro ? '#e2e8f0' : '#475569';
            var grillaColor = oscuro ? 'rgba(255,255,255,.08)' : 'rgba(0,0,0,.08)';
            var indigo = '#4f6ef7';
            var verde = '#10b981';
            var paleta = ['#4f6ef7', '#10b981', '#f59e0b', '#ef4444', '#8b5cf6', '#06b6d4', '#ec4899', '#84cc16', '#f97316', '#64748b'];

            // Empleados por área (barra horizontal)
            new Chart(document.getElementById('chartAreas'), {
                type: 'bar',
                data: {
                    labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.AreasNombres)),
                    datasets: [{
                        label: 'Empleados',
                        data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.EmpleadosPorArea)),
                        backgroundColor: indigo + 'cc',
                        borderColor: indigo,
                        borderWidth: 1,
                        borderRadius: 4
                    }]
                },
                options: {
                    indexAxis: 'y',
                    responsive: true,
                    plugins: {
                        legend: { display: false },
                        tooltip: { backgroundColor: oscuro ? '#1e293b' : 'rgba(0,0,0,.8)' }
                    },
                    scales: {
                        x: { beginAtZero: true, ticks: { precision: 0 }, grid: { color: grillaColor } },
                        y: { ticks: { color: etiquetaColor, autoSkip: false }, grid: { display: false } }
                    }
                }
            });

            // Asistencias últimos 7 días (línea)
            new Chart(document.getElementById('chartAsistencia'), {
                type: 'line',
                data: {
                    labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DiasAsistencia)),
                    datasets: [{
                        label: 'Asistencias',
                        data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.AsistenciasPorDia)),
                        borderColor: verde,
                        backgroundColor: verde + '22',
                        fill: true,
                        tension: .35,
                        pointBackgroundColor: verde
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: { display: false },
                        tooltip: { backgroundColor: oscuro ? '#1e293b' : 'rgba(0,0,0,.8)' }
                    },
                    scales: {
                        x: { ticks: { color: etiquetaColor }, grid: { display: false } },
                        y: { beginAtZero: true, ticks: { precision: 0, color: etiquetaColor }, grid: { color: grillaColor } }
                    }
                }
            });

            // Empleados por estado (dona)
            new Chart(document.getElementById('chartEstados'), {
                type: 'doughnut',
                data: {
                    labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.EstadosNombres)),
                    datasets: [{
                        data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.EmpleadosPorEstado)),
                        backgroundColor: Model.EmpleadosPorEstado.Select((_, i) => paleta[i % paleta.Length]).ToArray(),
                        borderWidth: 2
                    }]
                },
                options: {
                    responsive: true,
                    cutout: '62%',
                    plugins: {
                        legend: { position: 'bottom', labels: { color: etiquetaColor, padding: 12 } },
                        tooltip: { backgroundColor: oscuro ? '#1e293b' : 'rgba(0,0,0,.8)' }
                    }
                }
            });

            // Re-dibujar con colores correctos al cambiar de tema
            var toggle = document.getElementById('themeToggle');
            if (toggle) toggle.addEventListener('click', function () { setTimeout(function () { location.reload(); }, 350); });
        })();
    </script>
}

<div class="row g-3 mb-2">
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-body">
                <h6 class="fw-semibold mb-3"><i class="bi bi-diagram-3 me-2 text-primary"></i>Empleados por área</h6>
                <canvas id="chartAreas"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-body">
                <h6 class="fw-semibold mb-3"><i class="bi bi-clock-history me-2 text-success"></i>Asistencias (últimos 7 días)</h6>
                <canvas id="chartAsistencia"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-body">
                <h6 class="fw-semibold mb-3"><i class="bi bi-person-badge me-2 text-warning"></i>Empleados por estado</h6>
                <canvas id="chartEstados"></canvas>
            </div>
        </div>
    </div>
</div>