@model DashboardViewModel
@{
    ViewData["Title"] = "Inicio";
    var hora = DateTime.Now.Hour;
    var saludo = hora < 12 ? "Buenos días" : hora < 19 ? "Buenas tardes" : "Buenas noches";
    var esCultura = new System.Globalization.CultureInfo("es-PE");
    var fechaHoy = DateTime.Now.ToString("dddd d 'de' MMMM 'de' yyyy", esCultura);
    fechaHoy = char.ToUpper(fechaHoy[0]) + fechaHoy[1..];
    var inactivos = Model.Empleados - Model.EmpleadosActivos;
}

<div class="inicio-cabecera d-flex flex-wrap align-items-end justify-content-between gap-3">
    <div>
        <h1>@saludo, @User.Identity?.Name</h1>
        <p class="inicio-fecha">@fechaHoy</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-controller="Permiso" asp-action="Nuevo" class="btn btn-outline-secondary">
            <i class="bi bi-calendar-plus me-1"></i>Registrar permiso
        </a>
        <a asp-controller="Empleado" asp-action="Nuevo" class="btn btn-primary">
            <i class="bi bi-person-plus me-1"></i>Nuevo empleado
        </a>
    </div>
</div>

@* El estado del personal en una sola linea de registro: la cifra que importa primero *@
<section class="registro-dia" aria-label="Resumen del personal">
    <a asp-controller="Empleado" asp-action="Index" class="registro-cifra registro-principal">
        <span class="registro-valor">@Model.EmpleadosActivos.ToString("N0", esCultura)</span>
        <span class="registro-etiqueta">Empleados activos</span>
        <span class="registro-detalle">de @Model.Empleados.ToString("N0", esCultura) registrados@(inactivos > 0 ? $", {inactivos.ToString("N0", esCultura)} inactivos" : "")</span>
    </a>
    <a asp-controller="Asistencia" asp-action="Index" class="registro-cifra">
        <span class="registro-valor">@Model.asistenciasHoy.ToString("N0", esCultura)</span>
        <span class="registro-etiqueta">Asistencias registradas hoy</span>
    </a>
    <a asp-controller="EstructuraOrganiz" asp-action="Index" class="registro-cifra">
        <span class="registro-valor">@Model.Areas.ToString("N0", esCultura)</span>
        <span class="registro-etiqueta">Unidades orgánicas</span>
    </a>
    <a asp-controller="Feriado" asp-action="Index" class="registro-cifra">
        <span class="registro-valor">@Model.FeriadosMes.Count</span>
        <span class="registro-etiqueta">Feriados este mes</span>
    </a>
</section>

<ul class="registro-secundario">
    <li><b>@Model.Personas.ToString("N0", esCultura)</b>personas en el registro, entre empleados y familiares</li>
    <li><a asp-controller="Catalogo" asp-action="Index" asp-route-tabla="Cargo"><b>@Model.Cargos.ToString("N0", esCultura)</b>cargos definidos</a></li>
</ul>

<div class="row g-3 mb-3">
    <div class="col-xl-8">
        <section class="card h-100">
            <div class="card-body">
                <h2 class="panel-titulo">Empleados por área</h2>
                <div class="chart-box"><canvas id="chartAreas" aria-label="Gráfico de empleados por área" role="img"></canvas></div>
            </div>
        </section>
    </div>
    <div class="col-xl-4">
        <section class="card h-100">
            <div class="card-body">
                <h2 class="panel-titulo">Feriados del mes</h2>
                @if (Model.FeriadosMes.Count == 0)
                {
                    <p class="text-secondary mb-2">No hay feriados registrados este mes.</p>
                    <a asp-controller="Feriado" asp-action="Nuevo" class="small">Registrar un feriado</a>
                }
                else
                {
                    <ul class="feriados-lista">
                        @foreach (var f in Model.FeriadosMes)
                        {
                            var partes = f.Split(" - ", 2);
                            <li>
                                <span class="feriado-fecha">@partes[0]</span>
                                <span>@(partes.Length > 1 ? partes[1] : "Feriado")</span>
                            </li>
                        }
                    </ul>
                }
            </div>
        </section>
    </div>
    <div class="col-xl-8">
        <section class="card h-100">
            <div class="card-body">
                <h2 class="panel-titulo">Asistencias de los últimos 7 días</h2>
                <div class="chart-box"><canvas id="chartAsistencia" aria-label="Gráfico de asistencias de los últimos 7 días" role="img"></canvas></div>
            </div>
        </section>
    </div>
    <div class="col-xl-4">
        <section class="card h-100">
            <div class="card-body">
                <h2 class="panel-titulo">Empleados por estado</h2>
                <div class="chart-box"><canvas id="chartEstados" aria-label="Gráfico de empleados por estado" role="img"></canvas></div>
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <script src="~/lib/chart.js/chart.umd.min.js"></script>
    <script>
        (function () {
            var areasNombres = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.AreasNombres));
            var areasData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.EmpleadosPorArea));
            var diasAsis = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DiasAsistencia));
            var asisData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.AsistenciasPorDia));
            var estadosNombres = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.EstadosNombres));
            var estadosData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.EmpleadosPorEstado));

            // Los colores salen de la hoja de estilos: un solo lugar define la paleta, en claro y en oscuro
            function paleta() {
                var css = getComputedStyle(document.documentElement);
                var v = function (n) { return css.getPropertyValue(n).trim(); };
                return {
                    registro: v('--registro'), manila: v('--manila'), tinta: v('--tinta'),
                    suave: v('--tinta-suave'), regla: v('--regla'), hoja: v('--hoja'),
                    estados: [v('--registro'), v('--manila'), v('--regla-fuerte'), v('--alerta')]
                };
            }

            Chart.defaults.font.family = getComputedStyle(document.body).fontFamily;
            Chart.defaults.font.size = 13;

            // Nombres de area largos se acortan en pantallas angostas; el nombre completo queda en el tooltip
            function etiquetaCorta(valor) {
                var texto = this.getLabelForValue(valor);
                var max = window.innerWidth < 576 ? 18 : 34;
                return texto.length > max ? texto.slice(0, max - 1) + '…' : texto;
            }

            function opcionesEjes(p, horizontal) {
                var valor = { beginAtZero: true, ticks: { precision: 0, color: p.suave }, grid: { color: p.regla }, border: { display: false } };
                var categoria = { ticks: { color: p.tinta, autoSkip: false, callback: etiquetaCorta }, grid: { display: false }, border: { color: p.regla } };
                return horizontal ? { x: valor, y: categoria } : { x: categoria, y: valor };
            }

            function tooltip(p) {
                return { backgroundColor: p.tinta, titleColor: p.hoja, bodyColor: p.hoja, padding: 10, cornerRadius: 4, displayColors: false };
            }

            var p = paleta();

            var chartAreas = new Chart(document.getElementById('chartAreas'), {
                type: 'bar',
                data: { labels: areasNombres, datasets: [{ label: 'Empleados', data: areasData, backgroundColor: p.registro, borderRadius: 2, maxBarThickness: 22 }] },
                options: { indexAxis: 'y', responsive: true, maintainAspectRatio: false,
                    plugins: { legend: { display: false }, tooltip: tooltip(p) }, scales: opcionesEjes(p, true) }
            });

            var chartAsistencia = new Chart(document.getElementById('chartAsistencia'), {
                type: 'bar',
                data: { labels: diasAsis, datasets: [{ label: 'Asistencias', data: asisData, backgroundColor: p.manila, borderRadius: 2, maxBarThickness: 48 }] },
                options: { responsive: true, maintainAspectRatio: false,
                    plugins: { legend: { display: false }, tooltip: tooltip(p) }, scales: opcionesEjes(p, false) }
            });

            var chartEstados = new Chart(document.getElementById('chartEstados'), {
                type: 'doughnut',
                data: { labels: estadosNombres, datasets: [{ data: estadosData, backgroundColor: p.estados, borderColor: p.hoja, borderWidth: 3 }] },
                options: { responsive: true, maintainAspectRatio: false, cutout: '64%',
                    plugins: { legend: { position: 'bottom', labels: { color: p.tinta, padding: 14, boxWidth: 12, boxHeight: 12 } }, tooltip: tooltip(p) } }
            });

            // Al cambiar de tema se vuelven a leer los colores, sin recargar la pagina
            document.addEventListener('evo:theme', function () {
                var p = paleta();
                chartAreas.data.datasets[0].backgroundColor = p.registro;
                chartAreas.options.scales = opcionesEjes(p, true);
                chartAreas.options.plugins.tooltip = tooltip(p);
                chartAsistencia.data.datasets[0].backgroundColor = p.manila;
                chartAsistencia.options.scales = opcionesEjes(p, false);
                chartAsistencia.options.plugins.tooltip = tooltip(p);
                chartEstados.data.datasets[0].backgroundColor = p.estados;
                chartEstados.data.datasets[0].borderColor = p.hoja;
                chartEstados.options.plugins.legend.labels.color = p.tinta;
                chartEstados.options.plugins.tooltip = tooltip(p);
                [chartAreas, chartAsistencia, chartEstados].forEach(function (c) { c.update(); });
            });
        })();
    </script>
}
