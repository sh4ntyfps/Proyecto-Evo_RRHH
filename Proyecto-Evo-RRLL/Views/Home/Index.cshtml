@model DashboardViewModel
@{
    ViewData["Title"] = "Inicio";
    var hora = DateTime.Now.Hour;
    var saludo = hora < 12 ? "Buenos días" : hora < 19 ? "Buenas tardes" : "Buenas noches";
    var esCultura = new System.Globalization.CultureInfo("es-ES");
    var fechaHoy = DateTime.Now.ToString("dddd, dd 'de' MMMM 'de' yyyy", esCultura);
    fechaHoy = esCultura.TextInfo.ToTitleCase(fechaHoy);
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-4">
    <div>
        <h3 class="mb-1">@saludo, @User.Identity?.Name</h3>
        <p class="text-secondary mb-0"></p>
    </div>
    <div class="text-secondary small text-lg-end">
        <i class="bi bi-calendar3 me-1"></i>@fechaHoy
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4 col-sm-6">
        <a asp-controller="Empleado" asp-action="Index" class="card stat-card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon bg-primary-subtle text-primary"><i class="bi bi-people"></i></div>
                <div>
                    <div class="text-secondary small text-uppercase">Empleados</div>
                    <div class="fs-3 fw-bold">@Model.Empleados</div>
                </div>
                <i class="bi bi-arrow-right stat-arrow"></i>
            </div>
        </a>
    </div>
    <div class="col-md-4 col-sm-6">
        <div class="card stat-card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon bg-success-subtle text-success"><i class="bi bi-person-vcard"></i></div>
                <div>
                    <div class="text-secondary small text-uppercase">Personas</div>
                    <div class="fs-3 fw-bold">@Model.Personas</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4 col-sm-6">
        <a asp-controller="Asistencia" asp-action="Index" class="card stat-card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon bg-info-subtle text-info"><i class="bi bi-clock-history"></i></div>
                <div>
                    <div class="text-secondary small text-uppercase">Asistencias hoy</div>
                    <div class="fs-3 fw-bold">@Model.asistenciasHoy</div>
                </div>
                <i class="bi bi-arrow-right stat-arrow"></i>
            </div>
        </a>
    </div>
    <div class="col-md-4 col-sm-6">
        <div class="card stat-card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon bg-warning-subtle text-warning"><i class="bi bi-diagram-3"></i></div>
                <div>
                    <div class="text-secondary small text-uppercase">Áreas</div>
                    <div class="fs-3 fw-bold">@Model.Areas</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4 col-sm-6">
        <a asp-controller="Catalogo" asp-action="Index" asp-route-tabla="Cargo" class="card stat-card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon bg-danger-subtle text-danger"><i class="bi bi-briefcase"></i></div>
                <div>
                    <div class="text-secondary small text-uppercase">Cargos</div>
                    <div class="fs-3 fw-bold">@Model.Cargos</div>
                </div>
                <i class="bi bi-arrow-right stat-arrow"></i>
            </div>
        </a>
    </div>
    <div class="col-md-4 col-sm-6">
        <a asp-controller="Empleado" asp-action="Index" class="card stat-card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon bg-success-subtle text-success"><i class="bi bi-person-check"></i></div>
                <div>
                    <div class="text-secondary small text-uppercase">Empleados activos</div>
                    <div class="fs-3 fw-bold">@Model.EmpleadosActivos</div>
                </div>
                <i class="bi bi-arrow-right stat-arrow"></i>
            </div>
        </a>
    </div>
    <div class="col-md-4 col-sm-6">
        <div class="card stat-card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon bg-danger-subtle text-danger"><i class="bi bi-calendar-heart"></i></div>
                <div>
                    <div class="text-secondary small text-uppercase">Feriados del mes</div>
                    <div class="fs-3 fw-bold">@Model.FeriadosDelMes</div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (Model.FeriadosMes.Count > 0)
{
    <div class="card mb-3">
        <div class="card-body py-2 d-flex flex-wrap gap-2 align-items-center">
            <span class="text-secondary small text-uppercase me-1">Próximos feriados:</span>
            @foreach (var f in Model.FeriadosMes)
            {
                <span class="badge text-bg-danger-subtle border border-danger-subtle">@f</span>
            }
        </div>
    </div>
}

<div class="row g-3 mb-3">
    <div class="col-lg-8">
        <div class="card h-100">
            <div class="card-body">
                <h6 class="fw-semibold mb-3"><i class="bi bi-diagram-3 me-2 text-primary"></i>Empleados por área</h6>
                <div class="chart-box"><canvas id="chartAreas"></canvas></div>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-body">
                <h6 class="fw-semibold mb-3"><i class="bi bi-person-badge me-2 text-warning"></i>Empleados por estado</h6>
                <div class="chart-box"><canvas id="chartEstados"></canvas></div>
            </div>
        </div>
    </div>
    <div class="col-12">
        <div class="card h-100">
            <div class="card-body">
                <h6 class="fw-semibold mb-3"><i class="bi bi-clock-history me-2 text-success"></i>Asistencias últimos 7 días</h6>
                <div class="chart-box"><canvas id="chartAsistencia"></canvas></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/chart.js/chart.umd.min.js"></script>
    <script>
        (function () {
            var azul = '#2563eb';   // = --evo-primary (mismo azul de toda la app)
            var verde = '#10b981';
            var paleta = ['#2563eb', '#10b981', '#f59e0b', '#ef4444', '#8b5cf6', '#06b6d4', '#ec4899', '#84cc16', '#f97316', '#64748b'];

            var areasNombres = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.AreasNombres));
            var areasData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.EmpleadosPorArea));
            var diasAsis = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DiasAsistencia));
            var asisData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.AsistenciasPorDia));
            var estadosNombres = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.EstadosNombres));
            var estadosData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.EmpleadosPorEstado));

            function tema() {
                var oscuro = document.documentElement.getAttribute('data-bs-theme') === 'dark';
                return {
                    etiqueta: oscuro ? '#e2e8f0' : '#475569',
                    grilla: oscuro ? 'rgba(255,255,255,.08)' : 'rgba(0,0,0,.08)',
                    tooltip: oscuro ? '#1e293b' : 'rgba(0,0,0,.8)'
                };
            }

            var t = tema();

            // Empleados por área (barra horizontal)
            var chartAreas = new Chart(document.getElementById('chartAreas'), {
                type: 'bar',
                data: {
                    labels: areasNombres,
                    datasets: [{
                        label: 'Empleados',
                        data: areasData,
                        backgroundColor: azul + 'cc',
                        borderColor: azul,
                        borderWidth: 1,
                        borderRadius: 4
                    }]
                },
                options: {
                    indexAxis: 'y',
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: { backgroundColor: t.tooltip }
                    },
                    scales: {
                        x: { beginAtZero: true, ticks: { precision: 0, color: t.etiqueta }, grid: { color: t.grilla } },
                        y: { ticks: { color: t.etiqueta, autoSkip: false }, grid: { display: false } }
                    }
                }
            });

            // Empleados por estado (dona)
            var chartEstados = new Chart(document.getElementById('chartEstados'), {
                type: 'doughnut',
                data: {
                    labels: estadosNombres,
                    datasets: [{
                        data: estadosData,
                        backgroundColor: estadosData.map(function (_, i) { return paleta[i % paleta.length]; }),
                        borderWidth: 2
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '62%',
                    plugins: {
                        legend: { position: 'bottom', labels: { color: t.etiqueta, padding: 12 } },
                        tooltip: { backgroundColor: t.tooltip }
                    }
                }
            });

            // Asistencias últimos 7 días (línea)
            var chartAsistencia = new Chart(document.getElementById('chartAsistencia'), {
                type: 'line',
                data: {
                    labels: diasAsis,
                    datasets: [{
                        label: 'Asistencias',
                        data: asisData,
                        borderColor: verde,
                        backgroundColor: verde + '22',
                        fill: true,
                        tension: .35,
                        pointBackgroundColor: verde
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: { backgroundColor: t.tooltip }
                    },
                    scales: {
                        x: { ticks: { color: t.etiqueta }, grid: { display: false } },
                        y: { beginAtZero: true, ticks: { precision: 0, color: t.etiqueta }, grid: { color: t.grilla } }
                    }
                }
            });

            // Recolorear los gráficos al cambiar de tema, sin recargar la página
            document.addEventListener('evo:theme', function () {
                var t = tema();

                chartAreas.options.plugins.tooltip.backgroundColor = t.tooltip;
                chartAreas.options.scales.x.ticks.color = t.etiqueta;
                chartAreas.options.scales.x.grid.color = t.grilla;
                chartAreas.options.scales.y.ticks.color = t.etiqueta;
                chartAreas.update();

                chartEstados.options.plugins.tooltip.backgroundColor = t.tooltip;
                chartEstados.options.plugins.legend.labels.color = t.etiqueta;
                chartEstados.update();

                chartAsistencia.options.plugins.tooltip.backgroundColor = t.tooltip;
                chartAsistencia.options.scales.x.ticks.color = t.etiqueta;
                chartAsistencia.options.scales.y.ticks.color = t.etiqueta;
                chartAsistencia.options.scales.y.grid.color = t.grilla;
                chartAsistencia.update();
            });
        })();
    </script>
}
