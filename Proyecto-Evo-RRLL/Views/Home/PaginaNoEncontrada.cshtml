@{
    ViewData["Title"] = "Página no encontrada";
    var statusCode = ViewData.Model is int codigo && codigo != 404 ? codigo : 404;
    var autenticado = User.Identity?.IsAuthenticated == true;
}

<div class="row justify-content-center py-5">
    <div class="col-md-8 col-lg-6 text-center">
        <div class="codigo-404 d-flex align-items-center justify-content-center mx-auto">
            <span>4</span>
            <span class="codigo-404-icon text-primary"><i class="bi bi-compass"></i></span>
            <span>4</span>
        </div>

        <h1 class="fs-2 fw-semibold mt-4">
            @if (statusCode == 403)
            {
                <text>Sin permisos suficientes</text>
            }
            else
            {
                <text>Página no encontrada</text>
            }
        </h1>
        <p class="text-secondary mx-auto" style="max-width:36rem">
            @if (statusCode == 403)
            {
                <text>No tienes acceso a esta sección del sistema. Si crees que es un error, contacta al administrador.</text>
            }
            else
            {
                <text>La página que buscas no existe, fue movida o el enlace que usaste está incorrecto.</text>
            }
        </p>

        <div class="d-flex justify-content-center gap-2 flex-wrap mt-4">
            @if (autenticado)
            {
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4">
                    <i class="bi bi-speedometer2 me-1"></i> Volver al inicio
                </a>
                <a asp-controller="Home" asp-action="Ayuda" class="btn btn-outline-secondary px-4">
                    <i class="bi bi-question-circle me-1"></i> Ayuda
                </a>
            }
            else
            {
                <a asp-controller="Seguridad" asp-action="Login" class="btn btn-primary px-4">
                    <i class="bi bi-box-arrow-in-right me-1"></i> Iniciar sesión
                </a>
            }
        </div>

        <p class="text-muted small mt-4 mb-0">Código de error: 404</p>
    </div>
</div>