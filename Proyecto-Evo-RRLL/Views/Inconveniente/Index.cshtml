@model List<Inconveniente>
@{
    ViewData["Title"] = "Inconvenientes";
    var idObjetivo = ViewBag.IdObjetivo as int?;
    var idActividad = ViewBag.IdActividad as int?;
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div>
        <h3 class="mb-0">Inconvenientes</h3>
        <span class="text-secondary small">Inconvenientes de actividades (plan operativo)</span>
    </div>
    <a asp-action="Nuevo" asp-route-idObjetivo="@idObjetivo" asp-route-idActividad="@idActividad" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Nuevo inconveniente</a>
</div>

<form method="get" class="mb-3 d-flex align-items-end gap-2 flex-wrap">
    <div style="min-width:160px">
        <label class="form-label">Objetivo</label>
        <input type="number" name="idObjetivo" value="@idObjetivo" min="0" class="form-control" onchange="this.form.submit()" />
    </div>
    <div style="min-width:160px">
        <label class="form-label">Actividad</label>
        <input type="number" name="idActividad" value="@idActividad" min="0" class="form-control" onchange="this.form.submit()" />
    </div>
    @if (idObjetivo is not null || idActividad is not null)
    {
        <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
    }
</form>

<div class="table-responsive">
    <table class="table table-hover align-middle" data-search-target>
        <thead>
            <tr>
                <th>Objetivo</th>
                <th>Actividad</th>
                <th>N°</th>
                <th>Inconveniente</th>
                <th>Importancia</th>
                <th>Desventaja</th>
                <th>Observación</th>
                <th style="width:110px">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="8" class="text-center text-secondary py-4">Sin registros.</td></tr>
            }
            @foreach (var i in Model)
            {
                <tr>
                    <td class="fw-semibold">@i.IdObjetivo</td>
                    <td>@i.Id_Actividad</td>
                    <td>@i.IdInconveniente</td>
                    <td>@i.Descripcion</td>
                    <td>@i.Importancia</td>
                    <td class="text-truncate" style="max-width:200px" title="@i.Desventaja">@i.Desventaja</td>
                    <td class="text-truncate" style="max-width:240px" title="@i.Observacion">@i.Observacion</td>
                    <td>
                        <a asp-action="Editar" asp-route-idObjetivo="@i.IdObjetivo" asp-route-idActividad="@i.Id_Actividad" asp-route-idInconveniente="@i.IdInconveniente" class="btn btn-sm btn-outline-primary" data-bs-toggle="tooltip" title="Editar"><i class="bi bi-pencil"></i></a>
                        <form asp-action="Eliminar" asp-route-idObjetivo="@i.IdObjetivo" asp-route-idActividad="@i.Id_Actividad" asp-route-idInconveniente="@i.IdInconveniente" method="post" class="d-inline"
                              onsubmit="return confirm('¿Eliminar este inconveniente?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger" data-bs-toggle="tooltip" title="Eliminar"><i class="bi bi-trash"></i></button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>