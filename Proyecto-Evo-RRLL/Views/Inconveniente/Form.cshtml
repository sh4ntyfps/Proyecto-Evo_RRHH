@model Inconveniente
@{
    ViewData["Title"] = ViewBag.EsNuevo == true ? "Nuevo inconveniente" : $"Editar inconveniente #{Model.IdInconveniente}";
    var esNuevo = ViewBag.EsNuevo == true;
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div>
        <h3 class="mb-0">@(esNuevo ? "Nuevo inconveniente" : "Editar inconveniente")</h3>
        <span class="text-secondary small">Complete los datos y guarde</span>
    </div>
    <a asp-action="Index" asp-route-idObjetivo="@ViewBag.IdObjetivo" asp-route-idActividad="@ViewBag.IdActividad" class="btn btn-outline-secondary">Volver</a>
</div>

<form asp-action="@(esNuevo ? "Nuevo" : "Editar")" method="post">
    <div class="card mb-3">
        <div class="card-header fw-semibold"><i class="bi bi-exclamation-octagon me-2"></i>Datos del inconveniente</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Id objetivo <span class="text-danger">*</span></label>
                    @if (esNuevo)
                    {
                        <input asp-for="IdObjetivo" type="number" class="form-control" min="0" />
                    }
                    else
                    {
                        <input asp-for="IdObjetivo" type="hidden" />
                        <input asp-for="IdObjetivo" type="number" class="form-control" disabled />
                    }
                </div>
                <div class="col-md-4">
                    <label class="form-label">Id actividad <span class="text-danger">*</span></label>
                    @if (esNuevo)
                    {
                        <input asp-for="Id_Actividad" type="number" class="form-control" min="0" />
                    }
                    else
                    {
                        <input asp-for="Id_Actividad" type="hidden" />
                        <input asp-for="Id_Actividad" type="number" class="form-control" disabled />
                    }
                </div>
                <div class="col-md-4">
                    <label class="form-label">N. inconveniente</label>
                    <input asp-for="IdInconveniente" type="number" class="form-control" value="@(esNuevo ? "" : Model.IdInconveniente.ToString())" disabled />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Inconveniente <span class="text-danger">*</span></label>
                    <input asp-for="Descripcion" class="form-control" maxlength="70" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Importancia</label>
                    <input asp-for="Importancia" type="number" class="form-control" min="0" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Desventaja</label>
                    <input asp-for="Desventaja" class="form-control" maxlength="70" />
                </div>
                <div class="col-md-12">
                    <label class="form-label">Observación</label>
                    <textarea asp-for="Observacion" class="form-control" rows="3" maxlength="300"></textarea>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2">
        <a asp-action="Index" asp-route-idObjetivo="@ViewBag.IdObjetivo" asp-route-idActividad="@ViewBag.IdActividad" class="btn btn-outline-secondary">Cancelar</a>
        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Guardar</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}