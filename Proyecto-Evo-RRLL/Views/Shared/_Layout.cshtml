<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Proyecto EVO RRHH</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <svg xmlns="http://www.w3.org/2000/svg" style="display:none">
        <symbol id="i-moon" viewBox="0 0 16 16">
            <path d="M6 .278a.768.768 0 0 1 .08.858 7.208 7.208 0 0 0-.878 3.46c0 4.021 3.278 7.277 7.318 7.277.527 0 1.04-.055 1.533-.16a.787.787 0 0 1 .81.316.733.733 0 0 1-.031.893A8.349 8.349 0 0 1 8.344 16C3.734 16 0 12.286 0 7.71 0 4.266 2.114 1.312 5.124.06A.752.752 0 0 1 6 .278z" fill="currentColor"/>
        </symbol>
        <symbol id="i-sun" viewBox="0 0 16 16">
            <path d="M8 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM8 0a.5.5 0 0 1 .5.5v2a.5.5 0 0 1-1 0v-2A.5.5 0 0 1 8 0zm0 13a.5.5 0 0 1 .5.5v2a.5.5 0 0 1-1 0v-2A.5.5 0 0 1 8 13zm8-5a.5.5 0 0 1-.5.5h-2a.5.5 0 0 1 0-1h2a.5.5 0 0 1 .5.5zM3 8a.5.5 0 0 1-.5.5h-2a.5.5 0 0 1 0-1h2A.5.5 0 0 1 3 8zm10.657-5.657a.5.5 0 0 1 0 .707l-1.414 1.415a.5.5 0 1 1-.707-.708l1.414-1.414a.5.5 0 0 1 .707 0zm-9.193 9.193a.5.5 0 0 1 0 .707L3.05 13.657a.5.5 0 0 1-.707-.707l1.414-1.414a.5.5 0 0 1 .707 0zm9.193 2.121a.5.5 0 0 1-.707 0l-1.414-1.414a.5.5 0 0 1 .707-.707l1.414 1.414a.5.5 0 0 1 0 .707zM4.464 4.465a.5.5 0 0 1-.707 0L2.343 3.05a.5.5 0 1 1 .707-.707l1.414 1.414a.5.5 0 0 1 0 .708z" fill="currentColor"/>
        </symbol>
        <symbol id="i-arrow-up" viewBox="0 0 16 16">
            <path d="M8 15a.5.5 0 0 0 .5-.5V2.707l3.146 3.147a.5.5 0 0 0 .708-.708l-4-4a.5.5 0 0 0-.708 0l-4 4a.5.5 0 1 0 .708.708L7.5 2.707V14.5a.5.5 0 0 0 .5.5z" fill="currentColor"/>
        </symbol>
        <symbol id="i-search" viewBox="0 0 16 16">
            <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z" fill="currentColor"/>
        </symbol>
    </svg>

    <a class="skip-link" href="#contenido">Saltar al contenido</a>

    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm fixed-top">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" asp-area="" asp-controller="Home" asp-action="Index">EVO RRHH</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navPrincipal" aria-controls="navPrincipal"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="navbar-collapse collapse" id="navPrincipal">
                        <ul class="navbar-nav flex-grow-1">
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Home" asp-action="Index">Inicio</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Empleado" asp-action="Index">Personal</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Asistencia" asp-action="Index">Asistencia</a>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Mantenimiento</a>
                                <ul class="dropdown-menu">
                                    @foreach (var catalogo in Proyecto_Evo_RRLL.Models.ViewModels.CatalogoNavegacion.Items)
                                    {
                                        <li>
                                            <a class="dropdown-item" asp-controller="Catalogo" asp-action="Index" asp-route-tabla="@catalogo.Key">@catalogo.Value</a>
                                        </li>
                                    }
                                </ul>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Home" asp-action="Ayuda">Ayuda</a>
                            </li>
                        </ul>
                        <form class="d-flex me-2 my-2 my-lg-0" role="search" onsubmit="return false;">
                            <div class="input-group">
                                <span class="input-group-text bg-white text-secondary"><svg width="16" height="16" style="margin-bottom:.1rem"><use href="#i-search"></use></svg></span>
                                <input id="siteSearch" type="search" class="form-control"
                                       placeholder="Buscar en la página..." aria-label="Buscar en la página" />
                            </div>
                        </form>
                        <ul class="navbar-nav d-flex align-items-lg-center">
                            <li class="nav-item">
                                <button id="themeToggle" class="btn btn-outline-light btn-sm theme-toggle me-2 my-1 my-lg-0"
                                        type="button" aria-label="Cambiar tema">
                                    <svg width="16" height="16"><use id="themeIcon" href="#i-moon"></use></svg>
                                </button>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    @User.Identity.Name
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <form asp-controller="Seguridad" asp-action="CerrarSesion" method="post">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item">Cerrar sesión</button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        </ul>
                    </div>
                }
            </div>
        </nav>
    </header>

    <main id="contenido" role="main" class="container py-4">
        @if (TempData["MensajeExito"] is string exito)
        {
            <div class="alert alert-success alert-dismissible alert-auto" role="alert">
                @exito
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
            </div>
        }
        @if (TempData["MensajeError"] is string error)
        {
            <div class="alert alert-danger alert-dismissible alert-auto" role="alert">
                @error
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
            </div>
        }
        @RenderBody()
    </main>

    <footer class="border-top footer text-muted py-3" style="position:absolute; right:0; bottom:0; left:0; height:60px;">
        <div class="container d-flex justify-content-between flex-wrap">
            <span>EVO RRHH &copy; @DateTime.Now.Year</span>
            <span class="small">Última actualización: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</span>
        </div>
    </footer>

    <div id="cookieBanner" class="cookie-banner bg-body-tertiary shadow-lg" role="region" aria-label="Aviso de cookies">
        <div class="container py-3 d-flex align-items-center justify-content-between flex-wrap gap-2">
            <p class="mb-0 small">Este sitio utiliza cookies para recordar tus preferencias (tema oscuro) y sesión. Al continuar navegando aceptas su uso.</p>
            <button id="cookieAccept" type="button" class="btn btn-primary btn-sm">Aceptar</button>
        </div>
    </div>

    <button id="backToTop" type="button" class="btn btn-primary back-to-top" aria-label="Volver arriba">
        <svg width="18" height="18"><use href="#i-arrow-up"></use></svg>
    </button>

    <div id="loadingSpinner" class="loading-spinner" aria-hidden="true">
        <div class="spinner-border text-light" role="status">
            <span class="visually-hidden">Cargando...</span>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>