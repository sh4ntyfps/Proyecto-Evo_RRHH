@model CatalogoViewModel
@{
    ViewData["Title"] = Model.Titulo;
    var esEdicion = Model.Claves.Length > 0;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>@Model.Titulo</h3>
    <a asp-action="Index" asp-route-tabla="@Model.Tabla" class="btn btn-outline-secondary">Volver</a>
</div>

<form asp-action="@(esEdicion ? "Editar" : "Nuevo")" asp-route-tabla="@Model.Tabla" method="post">
    @Html.AntiForgeryToken()
    @if (esEdicion)
    {
        <input type="hidden" name="ids" value="@string.Join("|", Model.Claves.Select(c => Model.Valores![c]?.ToString() ?? ""))" />
    }

    <div class="card">
        <div class="card-body">
            <div class="row g-3">
                @foreach (var col in Model.Columnas.Where(c => !c.EsArchivo))
                {
                    var valorActual = Model.Valores!.TryGetValue(col.Nombre, out var v) ? v : null;

                    <div class="col-md-4">
                        <label class="form-label fw-semibold">@col.Nombre</label>
                        @if (col.Tipo == "string")
                        {
                            <input type="text" class="form-control" name="@col.Nombre" value="@(valorActual?.ToString() ?? "")" @(esEdicion && col.EsClave ? "readonly" : "") />
                        }
                        else if (col.Tipo == "bool")
                        {
                            <div class="form-check mt-2">
                                <input class="form-check-input" type="checkbox" id="@col.Nombre" name="@col.Nombre" value="true" @(valorActual is bool b && b ? "checked" : "") />
                                <label class="form-check-label" for="@col.Nombre">Activo</label>
                            </div>
                        }
                        else if (col.Tipo is "DateTime" or "DateOnly")
                        {
                            var fecha = valorActual is DateTime dt ? dt.ToString("yyyy-MM-dd") :
                                        valorActual is DateOnly d ? d.ToString("yyyy-MM-dd") : "";
                            <input type="date" class="form-control" name="@col.Nombre" value="@fecha" @(esEdicion && col.EsClave ? "readonly" : "") />
                        }
                        else if (col.Tipo is "Int32" or "Int64" or "Decimal" or "Double" or "Int16")
                        {
                            <input type="text" inputmode="decimal" class="form-control" name="@col.Nombre" value="@(valorActual?.ToString() ?? "")" @(esEdicion && col.EsClave ? "readonly" : "") />
                        }
                        else
                        {
                            <input type="text" class="form-control" name="@col.Nombre" value="@(valorActual?.ToString() ?? "")" @(esEdicion && col.EsClave ? "readonly" : "") />
                        }
                    </div>
                }
            </div>
        </div>
        <div class="card-footer d-flex justify-content-end">
            <button type="submit" class="btn btn-primary">Guardar</button>
        </div>
    </div>
</form>