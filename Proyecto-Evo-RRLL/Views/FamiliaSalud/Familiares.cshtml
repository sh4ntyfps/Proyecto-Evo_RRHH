@model List<FamiliarFila>
@{
    ViewData["Title"] = "Familiares";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="mb-0">Familiares</h3>
        <span class="text-muted">Empleado @ViewBag.IdEmpleado — @ViewBag.NombreEmpleado</span>
    </div>
    <a asp-action="Index" asp-route-idEmpleado="@((int)ViewBag.IdEmpleado)" class="btn btn-outline-secondary">Volver</a>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">Sin familiares registrados.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover table-bordered align-middle">
            <thead class="table-light">
                <tr>
                    <th>Id Persona</th>
                    <th>Nombre</th>
                    <th>Tipo familiar</th>
                    <th>Sexo</th>
                    <th>Ocupación</th>
                    <th>Estado civil</th>
                    <th>Vive en casa</th>
                    <th>Labora en institución</th>
                    <th>Discapacidad</th>
                    <th>Grupo sanguíneo</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var f in Model)
                {
                    <tr>
                        <td class="fw-semibold">@f.IdPersona</td>
                        <td>@f.Nombres</td>
                        <td>@f.TipoFamiliar</td>
                        <td>@f.Sexo</td>
                        <td>@f.Ocupacion</td>
                        <td>@f.EstadoCivil</td>
                        <td>@f.ViveCasa</td>
                        <td>@f.LaboraInstitucion</td>
                        <td>@f.Discapacidad</td>
                        <td>@f.TipoSangre</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}