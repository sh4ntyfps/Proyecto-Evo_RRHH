@model Permiso
@{
    ViewData["Title"] = "Permiso";
    var idEmpleado = ViewBag.IdEmpleado as int? ?? Model.IdEmpleado;
    var esNuevo = Model.NPermiso == 0;
    var empleados = ViewBag.Empleados as List<(int Id, string Nombre)> ?? new List<(int, string)>();
    var motivos = ViewBag.Motivos as List<Motivo_Perm> ?? new List<Motivo_Perm>();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>@(esNuevo ? "Nuevo permiso" : $"Editar permiso #{Model.NPermiso}")</h3>
    <a asp-action="Index" asp-route-idEmpleado="@idEmpleado" class="btn btn-outline-secondary">Volver</a>
</div>

<form asp-action="@(esNuevo ? "Nuevo" : "Editar")" method="post">
    <div class="card">
        <div class="card-body">
            @if (!esNuevo)
            {
                <input type="hidden" asp-for="IdEmpleado" />
                <input type="hidden" asp-for="NPermiso" />
            }
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Empleado *</label>
                    <select asp-for="IdEmpleado" class="form-select" required>
                        <option value="">(seleccionar)</option>
                        @foreach (var e in empleados)
                        {
                            <option value="@e.Id">@e.Nombre</option>
                        }
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Motivo</label>
                    <select asp-for="idMotivo" class="form-select">
                        <option value="">(sin asignar)</option>
                        @foreach (var m in motivos)
                        {
                            <option value="@m.idMotivo">@m.Descrip_Motivo</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Fecha inicio</label>
                    <input asp-for="FechaInicio" type="date" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Fecha fin</label>
                    <input asp-for="FechaFin" type="date" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Hora salida</label>
                    <input asp-for="Hora_Sal" type="time" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Hora retorno</label>
                    <input asp-for="Hora_Ret" type="time" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Lugar</label>
                    <input asp-for="Lugar" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Referencia</label>
                    <input asp-for="Referencia" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Autorización JH</label>
                    <input asp-for="Autorizacion" class="form-control" placeholder="Nombre..." />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Autorización RRHH</label>
                    <input asp-for="AutorizacionRRHH" class="form-control" placeholder="Nombre..." />
                </div>
                <div class="col-md-4">
                    <div class="form-check form-switch mt-4">
                        <input asp-for="Dia" class="form-check-input" type="checkbox" />
                        <label asp-for="Dia" class="form-check-label">Permiso por día</label>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-check form-switch mt-4">
                        <input asp-for="Retorno" class="form-check-input" type="checkbox" />
                        <label asp-for="Retorno" class="form-check-label">Con retorno</label>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-check form-switch mt-4">
                        <input asp-for="Autorizado" class="form-check-input" type="checkbox" />
                        <label asp-for="Autorizado" class="form-check-label">Autorizado</label>
                    </div>
                </div>
                <div class="col-12">
                    <label class="form-label">Observaciones</label>
                    <textarea asp-for="Obs" class="form-control" rows="2"></textarea>
                </div>
            </div>
        </div>
        <div class="card-footer d-flex justify-content-end">
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Guardar</button>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}