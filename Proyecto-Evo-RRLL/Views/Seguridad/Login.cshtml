@model LoginViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
    ViewData["PantallaCompleta"] = true;
}

<div class="auth-split">
    <aside class="auth-brand-panel" aria-hidden="true">
        <div class="auth-carpeta"><span class="auth-carpeta-rotulo">RRHH</span></div>
        <p class="auth-brand-title">El legajo de cada trabajador, en un solo lugar.</p>
        <p class="auth-brand-subtitle">Ficha personal, asistencia, permisos, capacitación, salud y familia, con el historial de cada cambio.</p>
    </aside>

    <section class="auth-form-panel position-relative">
        <button id="themeToggle" class="icon-btn auth-tema" type="button" aria-label="Cambiar a tema oscuro" title="Cambiar tema">
            <i id="themeIcon" class="bi bi-moon"></i>
        </button>

        <div class="auth-form-wrap">
            <h1 class="h2">Iniciar sesión</h1>
            <p class="auth-ayuda mb-4">Usa el usuario y la clave que te asignó el administrador del sistema.</p>

            @if (!string.IsNullOrEmpty(Model.Error))
            {
                <div class="alert alert-danger py-2" role="alert">@Model.Error Revisa ambos datos e inténtalo otra vez.</div>
            }

            <form asp-action="Login" method="post" data-enviando="Entrando…">
                <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>

                <div class="mb-3">
                    <label asp-for="Login" class="form-label">Usuario</label>
                    <input asp-for="Login" class="form-control form-control-lg" autofocus autocomplete="username" />
                    <span asp-validation-for="Login" class="text-danger small"></span>
                </div>
                <div class="mb-4">
                    <div class="d-flex justify-content-between align-items-baseline">
                        <label asp-for="Clave" class="form-label">Clave</label>
                        <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none" data-toggle-password="#Clave">Mostrar</button>
                    </div>
                    <input asp-for="Clave" class="form-control form-control-lg" autocomplete="current-password" />
                    <span asp-validation-for="Clave" class="text-danger small"></span>
                </div>
                <button type="submit" class="btn btn-primary btn-lg w-100">Entrar</button>
            </form>
        </div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
