@model LoginViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = "_Layout";
}

<div class="auth-page justify-content-center">
    <div class="auth-form-wrap" style="max-width:480px">
        <div class="card auth-login-card shadow-lg border-0">
            <div class="card-body p-4 p-md-5">
                <div class="d-flex align-items-center justify-content-center gap-2 mb-4">
                    <span class="brand-logo"><i class="bi bi-person-badge-fill"></i></span>
                    <h4 class="mb-0">Bienvenido</h4>
                </div>
                <p class="text-secondary text-center mb-4">Inicia sesión para continuar.</p>

                @if (!string.IsNullOrEmpty(Model.Error))
                {
                    <div class="alert alert-danger py-2 small"><i class="bi bi-exclamation-triangle me-1"></i>@Model.Error</div>
                }

                <form asp-action="Login" method="post">
                    <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>

                    <div class="mb-3">
                        <label asp-for="Login" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-person"></i></span>
                            <input asp-for="Login" class="form-control" autofocus placeholder="Usuario" />
                        </div>
                        <span asp-validation-for="Login" class="text-danger small"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="Clave" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-lock"></i></span>
                            <input asp-for="Clave" class="form-control" placeholder="Clave" />
                            <button type="button" class="btn btn-outline-secondary" data-toggle-password="#Clave">Mostrar</button>
                        </div>
                        <span asp-validation-for="Clave" class="text-danger small"></span>
                    </div>
                    <button type="submit" class="btn btn-primary w-100 py-2">
                        <i class="bi bi-box-arrow-in-right me-1"></i>Entrar
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}