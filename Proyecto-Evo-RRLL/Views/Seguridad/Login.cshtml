@model LoginViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
    ViewData["PantallaCompleta"] = true;
}

<div class="tw-grid tw-min-h-screen lg:tw-grid-cols-2">
    @* ---------- Panel de marca ---------- *@
    <aside class="tw-relative tw-hidden tw-overflow-hidden tw-bg-[#0b1120] tw-p-12 tw-text-white lg:tw-flex lg:tw-flex-col lg:tw-justify-between" aria-hidden="true">
        <div class="tw-absolute -tw-left-32 -tw-top-32 tw-h-[28rem] tw-w-[28rem] tw-rounded-full tw-bg-marca-600/40 tw-blur-3xl"></div>
        <div class="tw-absolute -tw-bottom-40 -tw-right-24 tw-h-[30rem] tw-w-[30rem] tw-rounded-full tw-bg-violet-600/30 tw-blur-3xl"></div>
        <div class="tw-fondo-malla tw-absolute tw-inset-0 tw-opacity-40"></div>

        <div class="tw-relative tw-flex tw-items-center tw-gap-3">
            <span class="tw-grid tw-h-11 tw-w-11 tw-place-items-center tw-rounded-xl tw-bg-gradient-to-br tw-from-marca-400 tw-via-marca-600 tw-to-violet-600 tw-text-xl tw-shadow-brillo"><i class="bi bi-people-fill"></i></span>
            <span class="tw-text-xl tw-font-extrabold tw-tracking-tight">RRHH</span>
        </div>

        @* Vista previa del producto *@
        <div class="tw-relative tw-mx-auto tw-w-full tw-max-w-md">
            <div class="tw-animate-flotar tw-rounded-3xl tw-border tw-border-white/10 tw-bg-white/[.06] tw-p-6 tw-shadow-2xl tw-backdrop-blur-xl">
                <div class="tw-flex tw-items-center tw-justify-between tw-text-sm tw-text-slate-300">
                    <span class="tw-font-semibold">Asistencia de hoy</span>
                    <span class="tw-rounded-full tw-bg-emerald-400/15 tw-px-2.5 tw-py-0.5 tw-text-xs tw-font-bold tw-text-emerald-300">En vivo</span>
                </div>
                <div class="tw-mt-3 tw-text-5xl tw-font-extrabold">94<span class="tw-text-2xl tw-text-slate-400">%</span></div>
                <div class="tw-mt-5 tw-flex tw-h-24 tw-items-end tw-gap-2">
                    @foreach (var alto in new[] { 45, 62, 54, 78, 70, 88, 94 })
                    {
                        <div class="tw-flex-1 tw-rounded-t-lg tw-bg-gradient-to-t tw-from-marca-600 tw-to-cyan-400" style="height:@alto%"></div>
                    }
                </div>
            </div>
            <div class="tw-absolute -tw-bottom-10 -tw-right-6 tw-w-64 tw-rounded-2xl tw-border tw-border-white/10 tw-bg-slate-900/90 tw-p-4 tw-shadow-2xl tw-backdrop-blur-xl" style="animation:flotar 7s ease-in-out infinite reverse">
                <div class="tw-flex tw-items-center tw-gap-3">
                    <span class="tw-grid tw-h-10 tw-w-10 tw-place-items-center tw-rounded-full tw-bg-gradient-to-br tw-from-fuchsia-500 tw-to-violet-600 tw-text-sm tw-font-bold">MQ</span>
                    <div class="tw-leading-tight">
                        <div class="tw-text-sm tw-font-bold">Permiso aprobado</div>
                        <div class="tw-text-xs tw-text-slate-400">Cita médica · 2 horas</div>
                    </div>
                    <i class="bi bi-check-circle-fill tw-ml-auto tw-text-emerald-400"></i>
                </div>
            </div>
        </div>

        <div class="tw-relative">
            <h2 class="tw-mb-3 tw-text-4xl tw-font-extrabold tw-leading-tight tw-text-white">Toda la gestión de tu personal, <span class="tw-bg-gradient-to-r tw-from-cyan-300 tw-to-marca-300 tw-bg-clip-text tw-text-transparent">en un solo lugar.</span></h2>
            <p class="tw-m-0 tw-max-w-md tw-text-slate-400">Legajos, asistencia, permisos, capacitación y bienestar, con la trazabilidad de cada cambio.</p>
            <div class="tw-mt-8 tw-flex tw-gap-8 tw-text-sm">
                <div><div class="tw-text-2xl tw-font-extrabold">13</div><div class="tw-text-slate-400">módulos</div></div>
                <div><div class="tw-text-2xl tw-font-extrabold">37</div><div class="tw-text-slate-400">tablas maestras</div></div>
                <div><div class="tw-text-2xl tw-font-extrabold">100%</div><div class="tw-text-slate-400">web y responsivo</div></div>
            </div>
        </div>
    </aside>

    @* ---------- Formulario ---------- *@
    <section class="tw-relative tw-flex tw-items-center tw-justify-center tw-bg-white tw-px-6 tw-py-12 dark:tw-bg-[#0b1020]">
        <button id="themeToggle" type="button" title="Cambiar tema" aria-label="Cambiar a tema oscuro"
                class="tw-absolute tw-right-5 tw-top-5 tw-grid tw-h-10 tw-w-10 tw-place-items-center tw-rounded-xl tw-border tw-border-slate-200 tw-bg-white tw-text-slate-600 dark:tw-border-slate-700 dark:tw-bg-slate-900 dark:tw-text-amber-300">
            <i id="themeIcon" class="bi bi-moon-stars"></i>
        </button>

        <div class="tw-w-full tw-max-w-sm tw-animate-entrar">
            <div class="tw-mb-8 tw-flex tw-items-center tw-gap-3 lg:tw-hidden">
                <span class="tw-grid tw-h-11 tw-w-11 tw-place-items-center tw-rounded-xl tw-bg-gradient-to-br tw-from-marca-400 tw-via-marca-600 tw-to-violet-600 tw-text-xl tw-text-white"><i class="bi bi-people-fill"></i></span>
                <span class="tw-text-xl tw-font-extrabold">RRHH</span>
            </div>

            <h1 class="tw-mb-2 tw-text-3xl tw-font-extrabold">Bienvenido de vuelta</h1>
            <p class="tw-mb-8 tw-text-slate-500">Ingresa con el usuario que te asignó el administrador.</p>

            @if (!string.IsNullOrEmpty(Model.Error))
            {
                <div class="alert alert-danger" role="alert"><i class="bi bi-exclamation-circle-fill"></i><span>@Model.Error Revisa tus datos e inténtalo de nuevo.</span></div>
            }

            <form asp-action="Login" method="post" data-enviando="Ingresando…" class="tw-space-y-5">
                <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                <div asp-validation-summary="ModelOnly" class="text-danger small"></div>

                <div>
                    <label asp-for="Login" class="form-label">Usuario</label>
                    <div class="tw-relative">
                        <i class="bi bi-person tw-pointer-events-none tw-absolute tw-left-4 tw-top-1/2 -tw-translate-y-1/2 tw-text-slate-400"></i>
                        <input asp-for="Login" class="form-control form-control-lg tw-pl-11" autofocus autocomplete="username" placeholder="tu.usuario" />
                    </div>
                    <span asp-validation-for="Login" class="text-danger small"></span>
                </div>

                <div>
                    <div class="tw-flex tw-items-baseline tw-justify-between">
                        <label asp-for="Clave" class="form-label">Contraseña</label>
                        <button type="button" class="btn btn-link btn-sm tw-p-0 tw-text-xs" data-toggle-password="#Clave">Mostrar</button>
                    </div>
                    <div class="tw-relative">
                        <i class="bi bi-lock tw-pointer-events-none tw-absolute tw-left-4 tw-top-1/2 -tw-translate-y-1/2 tw-text-slate-400"></i>
                        <input asp-for="Clave" class="form-control form-control-lg tw-pl-11" autocomplete="current-password" placeholder="••••••••" />
                    </div>
                    <span asp-validation-for="Clave" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary btn-lg tw-w-full">Ingresar <i class="bi bi-arrow-right"></i></button>
            </form>

            <p class="tw-mt-8 tw-text-center tw-text-sm tw-text-slate-500"><i class="bi bi-shield-check tw-mr-1 tw-text-emerald-500"></i>La sesión se cierra tras 8 horas sin actividad</p>
        </div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
