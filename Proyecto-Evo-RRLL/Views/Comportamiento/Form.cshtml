@model Comportamiento
@{
    ViewData["Title"] = Model.idComportamiento > 0 ? "Editar registro de comportamiento" : "Nuevo registro de comportamiento";
    var empleados = ViewBag.Empleados as List<(int Id, string Nombre)> ?? new List<(int, string)>();
    var tipos = ViewBag.Tipos as List<TipoComportamiento> ?? new List<TipoComportamiento>();
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div>
        <h3 class="mb-0">@(Model.idComportamiento > 0 ? "Editar registro" : "Nuevo registro")</h3>
        <span class="text-secondary small">Complete los datos y guarde</span>
    </div>
    <a asp-action="Index" asp-route-idEmpleado="@ViewBag.IdEmpleado" class="btn btn-outline-secondary">Volver</a>
</div>

<form asp-action="@(Model.idComportamiento > 0 ? "Editar" : "Nuevo")" method="post">
    <div asp-validation-summary="All" class="text-danger mb-3"></div>
    @if (Model.idComportamiento > 0)
    {
        <input type="hidden" asp-for="idComportamiento" />
    }

    <div class="card mb-3">
        <div class="card-header fw-semibold"><i class="bi bi-clipboard-data me-2"></i>Datos del comportamiento</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Empleado <span class="text-danger">*</span></label>
                    <select asp-for="IdEmpleado" class="form-select">
                        <option value="">(seleccione)</option>
                        @foreach (var e in empleados)
                        {
                            <option value="@e.Id" selected="@(Model.IdEmpleado == e.Id)">@e.Nombre</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Fecha</label>
                    <input asp-for="Fecha" type="date" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Tipo de comportamiento</label>
                    <select asp-for="idTipoComportamiento" class="form-select">
                        <option value="">(sin asignar)</option>
                        @foreach (var t in tipos)
                        {
                            <option value="@t.idTipoComportamiento" selected="@(Model.idTipoComportamiento == t.idTipoComportamiento)">@t.TipoCompDescrip</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">N. resolución</label>
                    <input asp-for="NumResol" class="form-control" />
                </div>
                <div class="col-md-12">
                    <label class="form-label">Título</label>
                    <input asp-for="Titulo" class="form-control" />
                </div>
                <div class="col-md-12">
                    <label class="form-label">Descripción</label>
                    <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2">
        <a asp-action="Index" asp-route-idEmpleado="@ViewBag.IdEmpleado" class="btn btn-outline-secondary">Cancelar</a>
        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Guardar</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}