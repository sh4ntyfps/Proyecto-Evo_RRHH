@model TitulosEmpleado
@{
    ViewData["Title"] = "Título";
    var idEmpleado = ViewBag.IdEmpleado as int? ?? Model.IdEmpleado;
    var esNuevo = string.IsNullOrEmpty(Model.NumColegiatura);
    var empleados = ViewBag.Empleados as List<(int Id, string Nombre)> ?? new List<(int, string)>();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>@(esNuevo ? "Nuevo título" : "Editar título")</h3>
    <a asp-action="Titulos" asp-route-idEmpleado="@idEmpleado" class="btn btn-outline-secondary">Volver</a>
</div>

<form asp-action="@(esNuevo ? "TituloNuevo" : "TituloEditar")" asp-route-numColegiatura="@(esNuevo ? null : Model.NumColegiatura)" method="post">
    <div class="card">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">N° colegiatura *</label>
                    <input asp-for="NumColegiatura" class="form-control" required />
                </div>
                <div class="col-md-8">
                    <label class="form-label">Denominación / grado</label>
                    <input asp-for="DenominacionGrado" class="form-control" />
                </div>
                <div class="col-md-8">
                    <label class="form-label">Institución</label>
                    <input asp-for="Institucion" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Fecha</label>
                    <input asp-for="Fecha" type="date" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Empleado</label>
                    <select asp-for="IdEmpleado" class="form-select">
                        <option value="">(sin asignar)</option>
                        @foreach (var e in empleados)
                        {
                            <option value="@e.Id">@e.Nombre</option>
                        }
                    </select>
                </div>
            </div>
        </div>
        <div class="card-footer d-flex justify-content-end">
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Guardar</button>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}