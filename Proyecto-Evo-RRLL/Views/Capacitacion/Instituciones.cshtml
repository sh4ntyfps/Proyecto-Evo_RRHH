@model List<Institucion>
@{
    ViewData["Title"] = "Instituciones";
    var tipos = ViewBag.TiposInstitucion as List<TipoInstitucion> ?? new List<TipoInstitucion>();
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <h3 class="mb-0">Instituciones</h3>
    <a asp-action="InstitucionNuevo" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Nueva institución</a>
</div>

<div class="table-responsive">
    <table class="table table-hover align-middle" data-search-target>
        <thead>
            <tr>
                <th>Descripción</th>
                <th>Dirección</th>
                <th style="width:110px">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="3" class="text-center text-secondary py-4">Sin registros.</td></tr>
            }
            @foreach (var i in Model)
            {
                <tr>
                    <td class="fw-semibold">@i.Descripcion</td>
                    <td>@i.Direccion</td>
                    <td>
                        <a asp-action="InstitucionEditar" asp-route-id="@i.IdInstitucion" class="btn btn-sm btn-outline-primary" data-bs-toggle="tooltip" title="Editar"><i class="bi bi-pencil"></i></a>
                        <form asp-action="InstitucionEliminar" asp-route-id="@i.IdInstitucion" method="post" class="d-inline"
                              onsubmit="return confirm('¿Eliminar esta institución?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger" data-bs-toggle="tooltip" title="Eliminar"><i class="bi bi-trash"></i></button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="d-flex gap-2 mt-3">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-mortarboard me-1"></i>Capacitaciones</a>
    <a asp-action="Estudios" class="btn btn-outline-secondary btn-sm"><i class="bi bi-journal-text me-1"></i>Estudios</a>
    <a asp-action="Titulos" class="btn btn-outline-secondary btn-sm"><i class="bi bi-award me-1"></i>Títulos</a>
</div>