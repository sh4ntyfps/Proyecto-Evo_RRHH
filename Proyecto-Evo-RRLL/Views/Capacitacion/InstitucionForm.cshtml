@model Institucion
@{
    ViewData["Title"] = "Institución";
    var esNuevo = Model.IdInstitucion == 0;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>@(esNuevo ? "Nueva institución" : $"Editar institución #{Model.IdInstitucion}")</h3>
    <a asp-action="Instituciones" class="btn btn-outline-secondary">Volver</a>
</div>

<form asp-action="@(esNuevo ? "InstitucionNuevo" : "InstitucionEditar")" asp-route-id="@(esNuevo ? null : Model.IdInstitucion)" method="post">
    <div class="card">
        <div class="card-body">
            @if (!esNuevo)
            {
                <input type="hidden" asp-for="IdInstitucion" />
            }
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Descripción *</label>
                    <input asp-for="Descripcion" class="form-control" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Dirección</label>
                    <input asp-for="Direccion" class="form-control" />
                </div>
            </div>
        </div>
        <div class="card-footer d-flex justify-content-end">
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Guardar</button>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}