@model Capa_Entidades.Capacitacion

@{
    ViewData["Title"] = Model.IdCapacitacion == 0 ? "Nueva capacitación" : "Editar capacitación";
    var empleados = ViewBag.Empleados as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? new List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();
}

<h2>@ViewData["Title"]</h2>

<form asp-action="CapacitacionForm" method="post">
    @Html.AntiForgeryToken()
    <div class="mb-3">
        <label class="form-label">Curso</label>
        <input asp-for="NombreCurso" class="form-control" />
    </div>
    <div class="row">
        <div class="col-md-3 mb-3">
            <label class="form-label">Fecha inicio</label>
            <input asp-for="FechaInicio" type="date" class="form-control" />
        </div>
        <div class="col-md-3 mb-3">
            <label class="form-label">Fecha fin</label>
            <input asp-for="FechaFin" type="date" class="form-control" />
        </div>
        <div class="col-md-3 mb-3">
            <label class="form-label">Horas</label>
            <input asp-for="NumHoras" class="form-control" />
        </div>
        <div class="col-md-3 mb-3">
            <label class="form-label">Empleado</label>
            <select asp-for="IdEmpleado" class="form-select">
                <option value="">-- Sin asignar --</option>
                @foreach (var e in empleados)
                {
                    <option value="@e.Value" selected="@(Model.IdEmpleado?.ToString() == e.Value ? "selected" : null)">@e.Text</option>
                }
            </select>
        </div>
    </div>
    <div class="mb-3">
        <label class="form-label">Institución organizadora</label>
        <input asp-for="InstitucionOrganizadora" class="form-control" />
    </div>

    <input type="hidden" asp-for="IdCapacitacion" />
    <button type="submit" class="btn btn-primary">Guardar</button>
    <a class="btn btn-secondary" asp-action="Index">Cancelar</a>
</form>
