@model EmpleadoDetalleViewModel
@{
    ViewData["Title"] = $"Empleado {Model.IdEmpleado}";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Detalle del empleado #@Model.IdEmpleado</h3>
    <div>
        <a asp-controller="FamiliaSalud" asp-action="Index" asp-route-idEmpleado="@Model.IdEmpleado" class="btn btn-outline-success">Ficha familiar y salud</a>
        <a asp-controller="Vivienda" asp-action="Index" asp-route-idEmpleado="@Model.IdEmpleado" class="btn btn-outline-info">Vivienda</a>
        <a asp-action="Editar" asp-route-id="@Model.IdEmpleado" class="btn btn-outline-secondary">Editar</a>
        <a asp-action="Index" class="btn btn-outline-secondary">Volver</a>
    </div>
</div>

<div class="row">
    <div class="col-md-4 mb-3">
        <div class="card">
            <div class="card-body text-center">
                @if (Model.TieneFoto)
                {
                    <img src="@Url.Action("MostrarFoto", "Empleado", new { id = Model.IdEmpleado })"
                         alt="Foto" style="width:150px;height:150px;object-fit:cover;border-radius:50%" class="shadow-sm" />
                }
                else
                {
                    <div class="display-5 text-muted">👤</div>
                }
                <h5 class="mt-3">@Model.NombresCompletos</h5>
                <span class="badge bg-primary">@Model.Estado</span>
            </div>
        </div>
    </div>
    <div class="col-md-8">
        <div class="card">
            <div class="card-header fw-bold">Información</div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6"><label class="text-muted">Tipo doc.</label><div class="fw-semibold">@Model.TipoDoc</div></div>
                    <div class="col-md-6"><label class="text-muted">N° documento</label><div class="fw-semibold">@Model.NumDoc</div></div>
                    <div class="col-md-6"><label class="text-muted">Sexo</label><div class="fw-semibold">@Model.Sexo</div></div>
                    <div class="col-md-6"><label class="text-muted">Cargo</label><div class="fw-semibold">@Model.Cargo</div></div>
                    <div class="col-md-6"><label class="text-muted">Área</label><div class="fw-semibold">@Model.Area</div></div>
                    <div class="col-md-6"><label class="text-muted">Local</label><div class="fw-semibold">@Model.Local</div></div>
                    <div class="col-md-6"><label class="text-muted">Horario</label><div class="fw-semibold">@Model.Horario</div></div>
                    <div class="col-md-6"><label class="text-muted">Fecha de ingreso</label><div class="fw-semibold">@(Model.FechaIngreso?.ToString("dd/MM/yyyy"))</div></div>
                    <div class="col-md-6"><label class="text-muted">Tipo de trabajador</label><div class="fw-semibold">@Model.TipoTrabajador</div></div>
                    <div class="col-md-6"><label class="text-muted">Régimen de pensión</label><div class="fw-semibold">@Model.RegimenPension</div></div>
                </div>
            </div>
        </div>
    </div>
</div>