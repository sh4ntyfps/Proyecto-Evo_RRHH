@model EmpleadoDetalleViewModel
@{
    ViewData["Title"] = "Ficha del empleado";
    var e = Model.Empleado;
    var p = Model.Persona;
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
    <div>
        <div class="d-flex align-items-center gap-2">
            <h2 class="fw-bold mb-0">Ficha del colaborador</h2>
            <span class="badge rounded-pill bg-dark text-white px-3 py-1 fs-6">#@Model.IdEmpleado</span>
        </div>
        <p class="text-secondary small mb-0 mt-1">@Model.NombresCompletos · @(Model.Cargo ?? "Sin cargo asignado")</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Editar" asp-route-id="@Model.IdEmpleado" class="btn btn-primary">
            <i class="bi bi-pencil me-1"></i> Editar ficha
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Volver al listado
        </a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-4">
        <!-- Tarjeta de Perfil Estilo Bruddle con Gradiente Aurora -->
        <div class="card text-center h-100 overflow-hidden shadow-sm">
            <div class="bruddle-aurora-banner"></div>
            <div class="card-body pt-0 px-4" style="margin-top: -55px;">
                @if (Model.TieneFoto)
                {
                    <img src="@Url.Action("MostrarFoto", new { id = Model.IdEmpleado })" alt="Foto" class="rounded-circle object-fit-cover mb-3" style="width:110px;height:110px; border: 4px solid #ffffff; box-shadow: 0 4px 14px rgba(0,0,0,0.15);" />
                }
                else
                {
                    <div class="mx-auto rounded-circle bg-white d-flex align-items-center justify-content-center text-dark mb-3" style="width:110px;height:110px;font-size:2.8rem; border: 4px solid #ffffff; box-shadow: 0 4px 14px rgba(0,0,0,0.15);">
                        <i class="bi bi-person"></i>
                    </div>
                }
                <h4 class="fw-bold mb-1">@Model.NombresCompletos</h4>
                <p class="text-secondary small mb-3">@(p?.Email ?? "Sin correo institucional")</p>

                <div class="mb-3">
                    @if (e?.Estado == EstadosEmpleado.Activo)
                    {
                        <span class="badge-bruddle-active"><i class="bi bi-check-circle-fill me-1"></i>Activo</span>
                    }
                    else if (e?.Estado == EstadosEmpleado.Inactivo)
                    {
                        <span class="badge-bruddle-inactive"><i class="bi bi-dash-circle-fill me-1"></i>Inactivo</span>
                    }
                    else
                    {
                        <span class="badge text-bg-light border">@(e?.Estado)</span>
                    }
                </div>

                <hr class="my-3 opacity-25" />

                <div class="text-start">
                    <div class="mb-2">
                        <span class="text-secondary small text-uppercase fw-bold d-block" style="font-size: .7rem; letter-spacing: .05em;">Cargo</span>
                        <span class="fw-semibold text-dark">@(Model.Cargo ?? "—")</span>
                    </div>
                    <div class="mb-2">
                        <span class="text-secondary small text-uppercase fw-bold d-block" style="font-size: .7rem; letter-spacing: .05em;">Área</span>
                        <span class="fw-semibold text-dark">@(Model.Area ?? "—")</span>
                    </div>
                    <div class="mb-2">
                        <span class="text-secondary small text-uppercase fw-bold d-block" style="font-size: .7rem; letter-spacing: .05em;">Sede / Local</span>
                        <span class="fw-semibold text-dark">@(Model.Local ?? "—")</span>
                    </div>
                    <div class="mb-2">
                        <span class="text-secondary small text-uppercase fw-bold d-block" style="font-size: .7rem; letter-spacing: .05em;">Horario</span>
                        <span class="fw-semibold text-dark">@(Model.Horario ?? "—")</span>
                    </div>
                    <div class="mb-0">
                        <span class="text-secondary small text-uppercase fw-bold d-block" style="font-size: .7rem; letter-spacing: .05em;">Fecha de ingreso</span>
                        <span class="fw-semibold text-dark">@(e?.FechaIngreso?.ToString("dd/MM/yyyy") ?? "—")</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card mb-3">
            <div class="card-header fw-bold py-3 bg-body-tertiary border-bottom"><i class="bi bi-person-badge me-2 text-primary"></i>Datos personales</div>
            <div class="card-body">
                <div class="row g-3 small">
                    <div class="col-md-4"><label class="text-secondary">Nombres</label><div class="fw-bold">@p?.Nombres</div></div>
                    <div class="col-md-4"><label class="text-secondary">Apellido paterno</label><div class="fw-bold">@p?.Apellido_Paterno</div></div>
                    <div class="col-md-4"><label class="text-secondary">Apellido materno</label><div class="fw-bold">@p?.Apellido_Materno</div></div>
                    <div class="col-md-3"><label class="text-secondary">Tipo documento</label><div class="fw-semibold">@Model.TipoDoc</div></div>
                    <div class="col-md-3"><label class="text-secondary">N° documento</label><div class="fw-bold font-monospace">@p?.NumDocID</div></div>
                    <div class="col-md-3"><label class="text-secondary">Sexo</label><div class="fw-semibold">@e?.Sexo</div></div>
                    <div class="col-md-3"><label class="text-secondary">Fecha nacimiento</label><div class="fw-semibold">@p?.FechaNacimiento?.ToString("dd/MM/yyyy")</div></div>
                    <div class="col-md-4"><label class="text-secondary">Estado civil</label><div class="fw-semibold">@Model.EstadoCivil</div></div>
                    <div class="col-md-4"><label class="text-secondary">Nacionalidad</label><div class="fw-semibold">@Model.Nacionalidad</div></div>
                    <div class="col-md-4"><label class="text-secondary">Tipo persona</label><div class="fw-semibold">@p?.TipoPersona</div></div>
                    <div class="col-md-4"><label class="text-secondary">Dirección</label><div class="fw-semibold">@p?.Direccion</div></div>
                    <div class="col-md-4"><label class="text-secondary">Ubigeo</label><div class="fw-semibold" style="word-break:break-all">@p?.IdUbigeo</div></div>
                    <div class="col-md-4"><label class="text-secondary">Ubigeo dirección</label><div class="fw-semibold">@p?.UbigeoDireccion</div></div>
                    <div class="col-md-4"><label class="text-secondary">Teléfono</label><div class="fw-semibold">@p?.Telefono</div></div>
                    <div class="col-md-4"><label class="text-secondary">Celular</label><div class="fw-semibold">@p?.NumCelular</div></div>
                    <div class="col-md-4"><label class="text-secondary">Fax</label><div class="fw-semibold">@p?.Fax</div></div>
                    <div class="col-md-4"><label class="text-secondary">Email</label><div class="fw-semibold" style="word-break:break-all">@p?.Email</div></div>
                    <div class="col-md-4"><label class="text-secondary">Tel. centro lab.</label><div class="fw-semibold">@p?.FonoCentroLab</div></div>
                </div>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header fw-bold py-3 bg-body-tertiary border-bottom"><i class="bi bi-briefcase me-2 text-primary"></i>Datos laborales</div>
            <div class="card-body">
                <div class="row g-3 small">
                    <div class="col-md-3"><label class="text-secondary">Tipo trabajador</label><div class="fw-semibold">@Model.TipoTrabajador</div></div>
                    <div class="col-md-3"><label class="text-secondary">Cargo</label><div class="fw-semibold">@Model.Cargo</div></div>
                    <div class="col-md-3"><label class="text-secondary">Área (año @e?.Year)</label><div class="fw-semibold">@Model.Area</div></div>
                    <div class="col-md-3"><label class="text-secondary">Local</label><div class="fw-semibold">@Model.Local</div></div>
                    <div class="col-md-3"><label class="text-secondary">Horario</label><div class="fw-semibold">@Model.Horario</div></div>
                    <div class="col-md-3"><label class="text-secondary">Estado</label><div class="fw-semibold">@e?.Estado</div></div>
                    <div class="col-md-3"><label class="text-secondary">Ingreso</label><div class="fw-semibold">@e?.FechaIngreso?.ToString("dd/MM/yyyy")</div></div>
                    <div class="col-md-3"><label class="text-secondary">Profesión</label><div class="fw-semibold">@e?.Profesion</div></div>
                    <div class="col-md-3"><label class="text-secondary">Grado instrucción</label><div class="fw-semibold">@e?.GradoInstruccion</div></div>
                    <div class="col-md-3"><label class="text-secondary">Brevete</label><div class="fw-semibold">@e?.Brevete</div></div>
                    <div class="col-md-3"><label class="text-secondary">Libreta militar</label><div class="fw-semibold">@e?.NumLibretaMilitar</div></div>
                    <div class="col-md-3"><label class="text-secondary">Cta. corriente</label><div class="fw-semibold">@e?.CtaCorriente</div></div>
                    <div class="col-md-3"><label class="text-secondary">Discapacidad</label><div class="fw-semibold">@Model.Discapacidad</div></div>
                    <div class="col-md-3"><label class="text-secondary">Exp. social</label><div class="fw-semibold">@e?.ExpSocial</div></div>
                </div>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header fw-bold py-3 bg-body-tertiary border-bottom"><i class="bi bi-shield-check me-2 text-primary"></i>Seguridad social y pensiones</div>
            <div class="card-body">
                <div class="row g-3 small">
                    <div class="col-md-3"><label class="text-secondary">AFP</label><div class="fw-semibold">@Model.AFP</div></div>
                    <div class="col-md-3"><label class="text-secondary">N° AFP</label><div class="fw-semibold">@e?.NroAFP</div></div>
                    <div class="col-md-3"><label class="text-secondary">Fecha AFP</label><div class="fw-semibold">@e?.FechaAFP?.ToString("dd/MM/yyyy")</div></div>
                    <div class="col-md-3"><label class="text-secondary">Régimen pensión</label><div class="fw-semibold">@Model.RegimenPension</div></div>
                    <div class="col-md-3"><label class="text-secondary">N° seguro</label><div class="fw-semibold">@e?.NroSeguro</div></div>
                    <div class="col-md-3"><label class="text-secondary">N° RUC</label><div class="fw-semibold">@e?.NumRUC</div></div>
                    <div class="col-md-3"><label class="text-secondary">Autogenerado salud</label><div class="fw-semibold">@e?.NumAutogenSalud</div></div>
                    <div class="col-md-3"><label class="text-secondary">Tipo sangre</label><div class="fw-semibold">@Model.TipoSangre</div></div>
                    <div class="col-md-3"><label class="text-secondary">Dcto. ley</label><div class="fw-semibold">@e?.DecLey</div></div>
                </div>
            </div>
        </div>
    </div>
</div>
