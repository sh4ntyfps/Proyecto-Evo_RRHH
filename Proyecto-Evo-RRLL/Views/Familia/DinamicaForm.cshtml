@model RRHH_DinamicaFamiliar
@{
    ViewData["Title"] = "Dinámica familiar";
    var esNuevo = Model.idDinamica == 0;
    var empleados = ViewBag.Empleados as List<(int Id, string Nombre)> ?? new List<(int, string)>();
    var tiposFamilia = ViewBag.TiposFamilia as List<RRHH_TipoFamilia> ?? new List<RRHH_TipoFamilia>();
    var relacPareja = ViewBag.RelacPareja as List<RRHH_RelacPareja> ?? new List<RRHH_RelacPareja>();
    var relacPH = ViewBag.RelacPH as List<RRHH_RelacPH> ?? new List<RRHH_RelacPH>();
    var relacHermano = ViewBag.RelacHermano as List<RRHH_RelacHermano> ?? new List<RRHH_RelacHermano>();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">@(esNuevo ? "Nueva evaluación de dinámica familiar" : "Editar dinámica familiar")</h3>
    <a asp-action="Dinamica" asp-route-idEmpleado="@Model.IdEmpleado" class="btn btn-outline-secondary">Volver</a>
</div>

<form asp-action="@(esNuevo ? "DinamicaNuevo" : "DinamicaEditar")" method="post">
    <div class="card">
        <div class="card-body">
            @if (!esNuevo)
            {
                <input type="hidden" asp-for="idDinamica" />
            }
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Empleado *</label>
                    <select asp-for="IdEmpleado" class="form-select" required>
                        <option value="">(seleccionar)</option>
                        @foreach (var e in empleados)
                        {
                            <option value="@e.Id">@e.Nombre</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Tipo de familia</label>
                    <select asp-for="idTipoFam" class="form-select">
                        <option value="">(sin asignar)</option>
                        @foreach (var t in tiposFamilia)
                        {
                            <option value="@t.idTipoFam">@t.TipoFamDescrip</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Relación de pareja</label>
                    <select asp-for="idRelaPareja" class="form-select">
                        <option value="">(sin asignar)</option>
                        @foreach (var r in relacPareja)
                        {
                            <option value="@r.idRelacPareja">@r.RelacParejaDescrip</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Relación P.H.</label>
                    <select asp-for="idRelaPH" class="form-select">
                        <option value="">(sin asignar)</option>
                        @foreach (var r in relacPH)
                        {
                            <option value="@r.idRelacPH">@r.RelacPHDescrip</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Relación de hermano</label>
                    <select asp-for="idRelacHermano" class="form-select">
                        <option value="">(sin asignar)</option>
                        @foreach (var r in relacHermano)
                        {
                            <option value="@r.idRelacHermano">@r.RelacHermanoDescrip</option>
                        }
                    </select>
                </div>
                <div class="col-12">
                    <label class="form-label">Observación</label>
                    <textarea asp-for="Observacion" class="form-control" rows="3"></textarea>
                </div>
            </div>
        </div>
        <div class="card-footer d-flex justify-content-end">
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Guardar</button>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
