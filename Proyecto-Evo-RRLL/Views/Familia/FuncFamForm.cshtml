@model RRHH_FuncFam
@{
    ViewData["Title"] = "Funcionalidad familiar";
    var esNuevo = Model.idFuncFamiliar == 0;
    var empleados = ViewBag.Empleados as List<(int Id, string Nombre)> ?? new List<(int, string)>();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">@(esNuevo ? "Nueva evaluación de funcionalidad familiar" : "Editar funcionalidad familiar")</h3>
    <a asp-action="FuncFam" asp-route-idEmpleado="@Model.IdEmpleado" class="btn btn-outline-secondary">Volver</a>
</div>

<form asp-action="@(esNuevo ? "FuncFamNuevo" : "FuncFamEditar")" method="post">
    <div class="card">
        <div class="card-body">
            @if (!esNuevo)
            {
                <input type="hidden" asp-for="idFuncFamiliar" />
            }
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Empleado *</label>
                    <select asp-for="IdEmpleado" class="form-select" required>
                        <option value="">(seleccionar)</option>
                        @foreach (var e in empleados)
                        {
                            <option value="@e.Id">@e.Nombre</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Comunicación 1</label>
                    <input asp-for="Com1" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Comunicación 2</label>
                    <input asp-for="Com2" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Afectividad 1</label>
                    <input asp-for="Afec1" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Afectividad 2</label>
                    <input asp-for="Afec2" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Decisiones 1</label>
                    <input asp-for="Decis1" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Decisiones 2</label>
                    <input asp-for="Decis2" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Social 1</label>
                    <input asp-for="Soc1" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Social 2</label>
                    <input asp-for="Soc2" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Social 3</label>
                    <input asp-for="Soc3" class="form-control" />
                </div>
            </div>
        </div>
        <div class="card-footer d-flex justify-content-end">
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Guardar</button>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
