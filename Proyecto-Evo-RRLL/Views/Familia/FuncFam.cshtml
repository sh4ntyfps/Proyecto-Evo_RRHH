@model List<RRHH_FuncFam>
@{
    ViewData["Title"] = "Funcionalidad familiar";
    var idEmpleado = ViewBag.IdEmpleado as int?;
    var empleados = ViewBag.Empleados as List<(int Id, string Nombre)> ?? new List<(int, string)>();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="mb-0">Funcionalidad familiar</h3>
        @if (idEmpleado is not null)
        {
            var emp = empleados.FirstOrDefault(e => e.Id == idEmpleado);
            <span class="text-secondary small">Empleado: @(emp.Nombre ?? "(sin asignar)")</span>
        }
    </div>
    <a asp-action="FuncFamNuevo" asp-route-idEmpleado="@idEmpleado" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Nueva evaluación</a>
</div>

<partial name="_FiltroEmpleado" model="@idEmpleado" />

<div class="table-responsive">
    <table class="table table-hover align-middle" data-search-target>
        <thead>
            <tr>
                <th>Empleado</th>
                <th>Com. 1</th>
                <th>Com. 2</th>
                <th>Afect. 1</th>
                <th>Afect. 2</th>
                <th>Decis. 1</th>
                <th>Decis. 2</th>
                <th>Soc. 1</th>
                <th>Soc. 2</th>
                <th>Soc. 3</th>
                <th style="width:110px">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="11" class="text-center text-secondary py-4">Sin evaluaciones de funcionalidad familiar.</td></tr>
            }
            @foreach (var f in Model)
            {
                var emp = empleados.FirstOrDefault(e => e.Id == f.IdEmpleado);
                <tr>
                    <td class="fw-semibold">@(emp.Nombre ?? $"(Empleado {f.IdEmpleado})")</td>
                    <td>@f.Com1</td>
                    <td>@f.Com2</td>
                    <td>@f.Afec1</td>
                    <td>@f.Afec2</td>
                    <td>@f.Decis1</td>
                    <td>@f.Decis2</td>
                    <td>@f.Soc1</td>
                    <td>@f.Soc2</td>
                    <td>@f.Soc3</td>
                    <td>
                        <a asp-action="FuncFamEditar" asp-route-id="@f.idFuncFamiliar" class="btn btn-sm btn-outline-primary" data-bs-toggle="tooltip" title="Editar"><i class="bi bi-pencil"></i></a>
                        <form asp-action="FuncFamEliminar" asp-route-id="@f.idFuncFamiliar" method="post" class="d-inline" onsubmit="return confirm('¿Eliminar esta evaluación?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger" data-bs-toggle="tooltip" title="Eliminar"><i class="bi bi-trash"></i></button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="d-flex gap-2 mt-3">
    <a asp-action="Index" asp-route-idEmpleado="@idEmpleado" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>Familiares</a>
    <a asp-action="Dinamica" asp-route-idEmpleado="@idEmpleado" class="btn btn-outline-primary btn-sm"><i class="bi bi-diagram-3 me-1"></i>Dinámica familiar</a>
</div>
