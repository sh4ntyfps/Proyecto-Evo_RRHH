@model List<Familiar>
@{
    ViewData["Title"] = "Familia";
    var idEmpleado = ViewBag.IdEmpleado as int?;
    var empleados = ViewBag.Empleados as List<(int Id, string Nombre)> ?? new List<(int, string)>();
    var personas = ViewBag.Personas as List<(int Id, string Nombre)> ?? new List<(int, string)>();
    var tipos = ViewBag.TiposFamiliar as List<TipoFamiliar> ?? new List<TipoFamiliar>();
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div>
        <h3 class="mb-0">Familiares del empleado</h3>
        @if (idEmpleado is not null)
        {
            var emp = empleados.FirstOrDefault(e => e.Id == idEmpleado);
            <span class="text-secondary small">Empleado: @emp.Nombre</span>
        }
    </div>
    <a asp-action="FamiliarNuevo" asp-route-idEmpleado="@idEmpleado" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Nuevo familiar</a>
</div>

<partial name="_FiltroEmpleado" model="@idEmpleado" />

<div class="table-responsive">
    <table class="table table-hover align-middle" data-search-target>
        <thead>
            <tr>
                <th>Familiar</th>
                <th>Empleado</th>
                <th>Vínculo</th>
                <th>Ocupación</th>
                <th>Grado instruc.</th>
                <th>Vive en casa</th>
                <th>Enfermedad</th>
                <th style="width:110px">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="8" class="text-center text-secondary py-4">Sin familiares registrados.</td></tr>
            }
            @foreach (var f in Model)
            {
                var per = personas.FirstOrDefault(p => p.Id == f.IdPersona);
                var emp = empleados.FirstOrDefault(e => e.Id == f.IdEmpleado);
                <tr>
                    <td class="fw-semibold">@per.Nombre</td>
                    <td>@emp.Nombre</td>
                    <td>@(tipos.FirstOrDefault(t => t.IdTipoFam == f.IdTipoFam)?.DescripTipoFam)</td>
                    <td>@f.FamOcupacion</td>
                    <td>@f.FamGradoInstruc</td>
                    <td>@(f.ViveCasa == true ? "Sí" : f.ViveCasa == false ? "No" : "")</td>
                    <td>@f.Enfermedad</td>
                    <td>
                        <a asp-action="FamiliarEditar" asp-route-idEmpleado="@f.IdEmpleado" asp-route-idPersona="@f.IdPersona" class="btn btn-sm btn-outline-primary" data-bs-toggle="tooltip" title="Editar"><i class="bi bi-pencil"></i></a>
                        <form asp-action="FamiliarEliminar" asp-route-idEmpleado="@f.IdEmpleado" asp-route-idPersona="@f.IdPersona" method="post" class="d-inline" onsubmit="return confirm('¿Eliminar este familiar?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger" data-bs-toggle="tooltip" title="Eliminar"><i class="bi bi-trash"></i></button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="d-flex gap-2 mt-3">
    <a asp-action="Dinamica" asp-route-idEmpleado="@idEmpleado" class="btn btn-outline-primary btn-sm"><i class="bi bi-diagram-3 me-1"></i>Dinámica familiar</a>
    <a asp-action="FuncFam" asp-route-idEmpleado="@idEmpleado" class="btn btn-outline-secondary btn-sm"><i class="bi bi-sliders me-1"></i>Funcionalidad familiar</a>
</div>