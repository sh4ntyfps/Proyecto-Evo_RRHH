@model ExpLaboral
@{
    ViewData["Title"] = "Experiencia laboral";
    var idEmpleado = ViewBag.IdEmpleado as int? ?? Model.IdEmpleado;
    var esNuevo = Model.IdExpLab == 0;
    var empleados = ViewBag.Empleados as List<(int Id, string Nombre)> ?? new List<(int, string)>();
    var tipos = ViewBag.TiposInstitucion as List<TipoInstitucion> ?? new List<TipoInstitucion>();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>@(esNuevo ? "Nueva experiencia" : $"Editar experiencia #{Model.IdExpLab}")</h3>
    <a asp-action="Index" asp-route-idEmpleado="@idEmpleado" class="btn btn-outline-secondary">Volver</a>
</div>

<form asp-action="@(esNuevo ? "ExpNuevo" : "ExpEditar")" method="post">
    <div class="card">
        <div class="card-body">
            @if (!esNuevo)
            {
                <input type="hidden" asp-for="IdEmpleado" />
                <input type="hidden" asp-for="IdExpLab" />
            }
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Empleado *</label>
                    <select asp-for="IdEmpleado" class="form-select" required>
                        <option value="">(seleccionar)</option>
                        @foreach (var e in empleados)
                        {
                            <option value="@e.Id">@e.Nombre</option>
                        }
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Institución</label>
                    <input asp-for="NomInstitucion" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Cargo</label>
                    <input asp-for="Cargo" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Unidad orgánica</label>
                    <input asp-for="UnidadOrganica" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Tipo de institución</label>
                    <select asp-for="IdTipoInstitucion" class="form-select">
                        <option value="">(sin asignar)</option>
                        @foreach (var t in tipos)
                        {
                            <option value="@t.IdTipoInstitucion">@t.DescripTipoInstitucion</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Fecha de ingreso</label>
                    <input asp-for="FechaIngreso" type="date" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Fecha de egreso</label>
                    <input asp-for="FechaEgreso" type="date" class="form-control" />
                </div>
            </div>
        </div>
        <div class="card-footer d-flex justify-content-end">
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Guardar</button>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}