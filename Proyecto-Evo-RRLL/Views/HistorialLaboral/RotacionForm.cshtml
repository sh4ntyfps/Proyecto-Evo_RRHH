@model Rotacion
@{
    ViewData["Title"] = "Rotación";
    var idEmpleado = ViewBag.IdEmpleado as int? ?? Model.idEmpleado;
    var esNuevo = Model.idRotacion == 0;
    var empleados = ViewBag.Empleados as List<(int Id, string Nombre)> ?? new List<(int, string)>();
    var areas = ViewBag.Areas as List<EstructOrganiz> ?? new List<EstructOrganiz>();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>@(esNuevo ? "Nueva rotación" : $"Editar rotación #{Model.idRotacion}")</h3>
    <a asp-action="Index" asp-route-idEmpleado="@idEmpleado" class="btn btn-outline-secondary">Volver</a>
</div>

<form asp-action="@(esNuevo ? "RotacionNuevo" : "RotacionEditar")" method="post">
    <div class="card">
        <div class="card-body">
            @if (!esNuevo)
            {
                <input type="hidden" asp-for="idEmpleado" />
                <input type="hidden" asp-for="idRotacion" />
            }
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Empleado *</label>
                    <select asp-for="idEmpleado" class="form-select" required>
                        <option value="">(seleccionar)</option>
                        @foreach (var e in empleados)
                        {
                            <option value="@e.Id">@e.Nombre</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">N° memo</label>
                    <input asp-for="NroMemo" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Fecha memo</label>
                    <input asp-for="FechaMemo" type="date" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Año</label>
                    <input asp-for="Year" type="number" class="form-control" placeholder="@DateTime.Now.Year" />
                </div>
                <div class="col-md-8">
                    <label class="form-label">Área organizacional</label>
                    <select asp-for="idAreaOrganiz" class="form-select">
                        <option value="">(sin asignar)</option>
                        @foreach (var a in areas.GroupBy(x => x.Year).LastOrDefault()?.ToList() ?? areas)
                        {
                            <option value="@a.idAreaOrganiz">@a.AreaOrganizacional</option>
                        }
                    </select>
                </div>
            </div>
        </div>
        <div class="card-footer d-flex justify-content-end">
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Guardar</button>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}