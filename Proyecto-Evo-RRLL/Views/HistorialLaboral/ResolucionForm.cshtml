@model Resolucion
@{
    ViewData["Title"] = "Resolución";
    var idEmpleado = ViewBag.IdEmpleado as int? ?? Model.idEmpleado;
    var esNuevo = Model.idResolucion == 0;
    var empleados = ViewBag.Empleados as List<(int Id, string Nombre)> ?? new List<(int, string)>();
    var tipos = ViewBag.TiposResolucion as List<TipoResolucion> ?? new List<TipoResolucion>();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>@(esNuevo ? "Nueva resolución" : $"Editar resolución #{Model.idResolucion}")</h3>
    <a asp-action="Index" asp-route-idEmpleado="@idEmpleado" class="btn btn-outline-secondary">Volver</a>
</div>

<form asp-action="@(esNuevo ? "ResolucionNuevo" : "ResolucionEditar")" method="post">
    <div class="card">
        <div class="card-body">
            @if (!esNuevo)
            {
                <input type="hidden" asp-for="idEmpleado" />
                <input type="hidden" asp-for="idResolucion" />
            }
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Empleado *</label>
                    <select asp-for="idEmpleado" class="form-select" required>
                        <option value="">(seleccionar)</option>
                        @foreach (var e in empleados)
                        {
                            <option value="@e.Id">@e.Nombre</option>
                        }
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Tipo de resolución</label>
                    <select asp-for="idTipoResolucion" class="form-select">
                        <option value="">(sin asignar)</option>
                        @foreach (var t in tipos)
                        {
                            <option value="@t.idTipoResolucion">@t.DescripTipoResolucion</option>
                        }
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label">N° resolución</label>
                    <input asp-for="NumeroResolucion" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Fecha</label>
                    <input asp-for="FechaResolucion" type="date" class="form-control" />
                </div>
            </div>
        </div>
        <div class="card-footer d-flex justify-content-end">
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Guardar</button>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}