@model List<RegAsisDiario>
@{
    ViewData["Title"] = "Registro Diario";
    var filtro = new Dictionary<string, object?>
    {
        ["Desde"] = ViewBag.Desde as DateTime?,
        ["Hasta"] = ViewBag.Hasta as DateTime?,
        ["IdEmpleado"] = ViewBag.IdEmpleado as int?
    };
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <h3 class="mb-0">Registro Diario de Asistencia</h3>
    <a asp-action="RegDiarioNuevo" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Nuevo registro</a>
</div>

<partial name="_FiltroAsistencia" model="@filtro" />

<div class="table-responsive">
    <table class="table table-hover align-middle" data-search-target>
        <thead>
            <tr>
                <th>Fecha</th>
                <th>Empleado</th>
                <th>Min. normales</th>
                <th>Min. tarde</th>
                <th>Estado</th>
                <th style="width:110px">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="6" class="text-center text-secondary py-4">Sin registros.</td></tr>
            }
            @foreach (var r in Model)
            {
                var emp = (ViewBag.Empleados as List<(int Id, string Nombre)> ?? new List<(int, string)>()).FirstOrDefault(e => e.Id == r.IdEmpleado);
                <tr>
                    <td class="fw-semibold">@r.Fecha.ToString("dd/MM/yyyy")</td>
                    <td>@emp.Nombre</td>
                    <td>@r.MinNormales</td>
                    <td>@r.MinTarde</td>
                    <td>@r.Estado</td>
                    <td>
                        <a asp-action="RegDiarioEditar" asp-route-fecha="@r.Fecha.ToString("yyyy-MM-dd")" asp-route-idEmpleado="@r.IdEmpleado" class="btn btn-sm btn-outline-primary" data-bs-toggle="tooltip" title="Editar"><i class="bi bi-pencil"></i></a>
                        <form asp-action="RegDiarioEliminar" asp-route-fecha="@r.Fecha.ToString("yyyy-MM-dd")" asp-route-idEmpleado="@r.IdEmpleado" method="post" class="d-inline" onsubmit="return confirm('¿Eliminar este registro?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger" data-bs-toggle="tooltip" title="Eliminar"><i class="bi bi-trash"></i></button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="d-flex gap-2 mt-3">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-clipboard-check me-1"></i>Registro de Asistencia</a>
    <a asp-action="Marcaciones" class="btn btn-outline-secondary btn-sm"><i class="bi bi-clock me-1"></i>Marcaciones</a>
    <a asp-action="HorariosTemporal" class="btn btn-outline-secondary btn-sm"><i class="bi bi-stopwatch me-1"></i>Horarios Temporales</a>
</div>