@model HorarioTemporal
@{
    ViewData["Title"] = "Horario temporal";
    var idEmpleado = ViewBag.IdEmpleado as int? ?? Model.idEmpleado;
    var esNuevo = Model.N == 0;
    var empleados = ViewBag.Empleados as List<(int Id, string Nombre)> ?? new List<(int, string)>();
    var horarios = ViewBag.Horarios as List<Horario> ?? new List<Horario>();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>@(esNuevo ? "Nuevo horario temporal" : $"Editar horario temporal #{Model.N}")</h3>
    <a asp-action="HorariosTemporal" asp-route-idEmpleado="@idEmpleado" class="btn btn-outline-secondary">Volver</a>
</div>

<form asp-action="@(esNuevo ? "HorarioTemporalNuevo" : "HorarioTemporalEditar")" method="post">
    <div class="card">
        <div class="card-body">
            @if (!esNuevo)
            {
                <input type="hidden" asp-for="idEmpleado" />
                <input type="hidden" asp-for="N" />
            }
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Empleado *</label>
                    <select asp-for="idEmpleado" class="form-select" required>
                        <option value="">(seleccionar)</option>
                        @foreach (var e in empleados)
                        {
                            <option value="@e.Id">@e.Nombre</option>
                        }
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Horario asignado</label>
                    <select asp-for="HorarioAsignado" class="form-select">
                        <option value="">(sin asignar)</option>
                        @foreach (var h in horarios)
                        {
                            <option value="@h.idHorario">@h.Descrip_Horario</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Fecha inicio</label>
                    <input asp-for="FechaInicio" type="date" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Fecha fin</label>
                    <input asp-for="FechaFin" type="date" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">N° documento</label>
                    <input asp-for="NroDocumento" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Sisgedo</label>
                    <input asp-for="Sisgedo" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Fecha de registro</label>
                    <input asp-for="FechaRegistro" type="datetime-local" class="form-control" />
                </div>
            </div>
        </div>
        <div class="card-footer d-flex justify-content-end">
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Guardar</button>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}